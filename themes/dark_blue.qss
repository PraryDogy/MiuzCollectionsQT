/* _base_widgets.py */

TransparentButton,
TransparentLabel,
TransparentFrame,
TransparentWidget,
TransparentLineEdit,
TransparentTextEdit,
TransparentMenu,
TransparentScrollArea,
UGroupBox,
TransparentListWidget,
TransparentTreeWidget,
TransparentTreeView {
    background: transparent;
    border: none;
}

UMainWindow,
UMainWidget {
    background: #0c1218;
}


/* ==================== MENU ==================== */

UMenu {
    background: #111a23;
    border: 1px solid #263440;
    border-radius: 10px;
    padding: 5px 2px 5px 2px;
}

UMenu::item {
    background: transparent;
    color: #ffffff;
    padding: 5px 30px 5px 10px;
}

UMenu::item:selected {
    background: #202c38;
    color: #ffffff;
}

UMenu::icon {
    padding-left: 5px;
}

UMenu::indicator {
    width: 16px;
    height: 16px;
    padding-left: 5px;
}

UMenu::indicator:checked {
    image: url(./icons/common/arrow_down.svg);
}

UMenu::indicator:unchecked {
    image: none;
}

UMenu::right-arrow {
    image: url("./icons/common/arrow_right.svg");
    width: 12px;
    height: 12px;
    padding-right: 5px;
}

UMenu::right-arrow:selected {
    image: url("./icons/common/arrow_right.svg");
}


/* ==================== INPUT ==================== */

ULineEdit {
    color: #ffffff;
    background: #151f29;
    border: 1px solid #263440;
    border-radius: 6px;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 5px;
    padding-bottom: 5px;
}

UTextEdit {
    color: #ffffff;
    background: #151f29;
    border: 1px solid #263440;
    border-radius: 6px;
    padding-left: 2px;
    padding-right: 2px;
}


/* ==================== SCROLL ==================== */

UScrollVerticalArea {
    background: transparent;
}


/* ==================== TREE / LIST ==================== */

UTreeView,
UListWidget,
UTreeWidget {
    color: #ffffff;
    background: #111a23;
    border: 1px solid #263440;
    border-radius: 10px;
    padding: 10px 2px 10px 2px;
}

UTreeView::item,
UListWidget::item,
UTreeWidget::item {
    color: #ffffff;
    background: transparent;
    height: 30px;
}

UTreeView::item:selected,
UTreeView::item:selected:!active,
UListWidget::item:selected,
UListWidget::item:selected:!active,
UTreeWidget::item:selected,
UTreeWidget::item:selected:!active {
    color: #ffffff;
    background: #202c38;
}

UTreeView::branch:has-children:closed,
UTreeWidget::branch:has-children:closed {
    image: url(./icons/common/plus.svg);
}

UTreeView::branch:has-children:open,
UTreeWidget::branch:has-children:open {
    image: url(./icons/common/minus.svg);
}

UTreeView::branch:selected,
UTreeWidget::branch:selected {
    background: #202c38;
}

UListWidget::indicator {
    width: 16px;
    height: 16px;
    background: #151f29;
    border: 1px solid #30404f;
    border-radius: 4px;
}

UListWidget::indicator:checked {
    image: url(./icons/common/arrow_down.svg);
}

UListWidget::indicator:disabled {
    background-color: #111a23;
    border-color: #1d2833;
}


/* ==================== BUTTON ==================== */

UPushButton {
    font-size: 11px;
    background: #18212a;
    border: 1px solid #263440;
    border-radius: 6px;
    color: #ffffff;
    padding-right: 5px;
    padding-left: 5px;
}

UPushButton:hover {
    background: #1d2833;
    border-color: #30404f;
}

UPushButton:pressed {
    background: #202c38;
    border: 1px solid #30404f;
}

UPushButton::menu-indicator {
    image: url("./icons/common/arrow_down.svg");
    width: 12px;
    height: 12px;
}


/* ==================== ACTIVE BUTTON ==================== */

ActiveButton {
    background: #0059D1;
    border: 1px solid #0e69df;
}

ActiveButton:hover {
    background: #0a63dc;
}

ActiveButton:pressed {
    background: #0e69df;
    border: 1px solid #2d7be1;
}


/* ==================== SEPARATOR ==================== */

USep {
    background: #1c2833;
}


/* ==================== SLIDER ==================== */

USlider::groove:horizontal {
	/* Цвет самой линии (дорожки) */
	background-color: #263440;
	/* Толщина линии */
	height: 3px;
	/* Небольшое скругление краев линии */
	border-radius: 1px;
	margin: 0px;
}

USlider::handle:horizontal {
	/* Цвет кружочка (ползунка) */
	background-color: #8f9ba6;
	/* Размеры задают квадрат 10x10 пикселей */
	height: 10px;
	width: 10px;
	/* Радиус скругления, равный половине ширины/высоты (10/2 = 5), делает из квадрата идеальный круг */
	border-radius: 5px;
	/* Смещаем ползунок вверх и вниз за пределы тонкой дорожки. 
	   Математика: (Высота ползунка 10px - Высота дорожки 3px) / 2 = 3.5px. 
	   Округление до 4px (или 3px) центрирует кружок относительно линии. */
	margin: -4px 0;
}


/* ==================== SPINBOX ==================== */

USpinBox {
    background: #151f29;
    color: #ffffff;
    border: 1px solid #263440;
    border-radius: 4px;
}

USpinBox::up-button,
USpinBox::down-button {
    background: #18212a;
    width: 17px;
    margin-right: 2px;
    border-radius: 3px;
}

USpinBox::up-button {
    height: 10px;
    margin-top: 2px;
}

USpinBox::down-button {
    height: 10px;
    margin-bottom: 2px;
}

USpinBox::up-button:hover,
USpinBox::down-button:hover {
    background: #1d2833;
}

USpinBox::up-button:pressed,
USpinBox::down-button:pressed {
    background: #202c38;
}

USpinBox::up-arrow {
    image: url("./icons/common/arrow_up.svg");
    width: 9px;
    height: 9px;
}

USpinBox::down-arrow {
    image: url("./icons/common/arrow_down.svg");
    width: 9px;
    height: 9px;
}


/* ==================== GROUP BOX ==================== */

UGroupBox {
    background: #111a23;
    border: 1px solid #263440;
    border-radius: 10px;
}


/* ==================== TAG ==================== */

UTagWidget {
    border-radius: 10px;
    color: #ffffff;
}

UTagWidget[style="blue"] {
    background: #0059D1;
    border: 1px solid #156ee3;
}

UTagWidget[style="gray"] {
    background: #303b46;
    border: 1px solid #3d4a56;
}

UTagWidget[style="transparent"] {
    background: transparent;
    border: 1px solid #30404f;
}

UTagWidget[style="green"] {
    background: #064E3B;
    border: 1px solid #10B981;
}


/* ==================== TOOLTIP ==================== */

QToolTip {
    color: #FFFFFF;
    background-color: #18212a;
    border: 1px solid #30404f;
    padding: 2px;
}


/* ==================== TEXT ==================== */

GrayTextLabel {
    color: #7b8792;
}

TitleTextLabel {
    font-weight: bold;
    font-size: 20px;
}


