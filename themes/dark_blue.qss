/* =====================================================================
   ТЁМНАЯ ТЕМА

   Порядок файла:
   1. Прозрачная основа: все виджеты стартуют прозрачными и без рамки.
   2. Цвета по группам: фон, рамка, текст. Каждый цвет в одном блоке.
   3. Геометрия: скругления, отступы, размеры, шрифты, иконки.

   Правило: при одинаковой специфичности побеждает правило, написанное
   позже. Поэтому основа идёт первой, а цвета перекрывают её.

   Стрелки спинбокса прозрачные: они показывают фон самого поля,
   и при наведении на поле меняется весь виджет целиком.

   Палитра:
   #000000  чёрный фон (просмотр изображений, превью поиска)
   #0c1218  фон UFrame
   #101820  фон панелей (GroupBox, списки, деревья, меню)
   #111a23  фон зоны перетаскивания
   #18212a  фон кнопок, полей ввода, спинбокса, тултипа
   #1d2833  наведение, выделение, отметка в списке, иконочные кнопки при наведении
   #202c38  нажатие, фон миниатюры в рамке
   #263440  рамка панелей и полей, дорожка слайдера
   #283645  иконочные кнопки: выбрано
   #30404f  рамка при наведении, чекбоксы, тег transparent
   #3a4b5e  иконочная кнопка: нажатие
   #0059d1  синий акцент: ActiveButton, синий тег, подпись миниатюры
   #303b46  серый тег
   #064e3b  зелёный тег
   #7b8792  серый текст подписей
   #6e6e6e  серый текст миниатюр
   #8f9ba6  ползунок слайдера
   #ffffff  основной текст
   ===================================================================== */


/* =====================================================================
   1. ПРОЗРАЧНАЯ ОСНОВА
   Этот блок должен стоять первым. Цвета ниже его перекрывают.
   ===================================================================== */

TransparentButton,
TransparentLabel,
TransparentFrame,
TransparentWidget,
TransparentLineEdit,
TransparentTextEdit,
TransparentMenu,
TransparentScrollArea,
MacControlButton,                /* проверить: grep по коду */
UFrame,
UBlackFrame,
UGroupBox,
UTreeView,
UListWidget,
UTreeWidget,
UMenu,
UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
USpinBox::up-button,
USpinBox::down-button,
USep,
UCheckBox,
UCheckBox::indicator,
UTagWidget,
UpBtnLabel,
ImgViewSvg,
_SvgWithThemeBg {
    background: transparent;
    border: none;
    color: #ffffff;
}

UTreeView::item,
UListWidget::item,
UTreeWidget::item,
UMenu::item {
    background: transparent;
    border: none;
}


/* =====================================================================
   2. ЦВЕТА ПО ГРУППАМ
   ===================================================================== */

/* ---------------------------------------------------------------------
   #000000  ЧЁРНЫЙ ФОН
   Чёрный контейнер, окно просмотра, превью поиска
   --------------------------------------------------------------------- */
UBlackFrame,
WinImgViewGraphics,
WinImageView,
WinImgSearchPreviewWidget {
    background: #000000;
}

UBlackFrame {
    border: 1px solid transparent;
}


/* ---------------------------------------------------------------------
   #0c1218  ФОН UFrame
   Формат #AARRGGBB: ff в начале означает полную непрозрачность.
   Рамка #1d2b38.
   --------------------------------------------------------------------- */
UFrame {
    background: #ff0c1218;
    border: 1px solid #ff1d2b38;
}


/* ---------------------------------------------------------------------
   #101820  ФОН ПАНЕЛЕЙ
   GroupBox, списки, деревья, меню
   --------------------------------------------------------------------- */
UGroupBox,
UListWidget,
UTreeView,
UTreeWidget,
UMenu {
    background: #101820;
}


/* ---------------------------------------------------------------------
   #111a23  ФОН ЗОНЫ ПЕРЕТАСКИВАНИЯ
   Поиск по изображению
   --------------------------------------------------------------------- */
WinImgSearchDropWidget {
    background: #111a23;
}


/* ---------------------------------------------------------------------
   #18212a  ФОН ЭЛЕМЕНТОВ ВВОДА
   Кнопки, поля, спинбокс, разделитель, тултип
   Стрелки спинбокса сюда не входят: они прозрачные (см. блок 1).
   --------------------------------------------------------------------- */
UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
USep,
QToolTip {
    background: #18212a;
}


/* ---------------------------------------------------------------------
   #1d2833  НАВЕДЕНИЕ И ВЫДЕЛЕНИЕ
   Наведение на поля, кнопки, спинбокс и иконочные кнопки,
   выбранные пункты списков, деревьев и меню, ветки дерева, отметка в списке
   --------------------------------------------------------------------- */
UPushButton:hover,
ULineEdit:hover,
UTextEdit:hover,
USpinBox:hover,
_SvgWithThemeBg:hover[style="base"],
UListWidget::indicator,
UListWidget::indicator:disabled,
UTreeView::item:selected,
UListWidget::item:selected,
UTreeWidget::item:selected,
UTreeView::item:selected:!active,
UListWidget::item:selected:!active,
UTreeWidget::item:selected:!active,
UMenu::item:selected,
UTreeView::branch:selected,
UTreeWidget::branch:selected {
    background: #1d2833;
}


/* ---------------------------------------------------------------------
   #202c38  НАЖАТИЕ
   Кнопка при нажатии, нажатая стрелка спинбокса, фон миниатюры в рамке
   --------------------------------------------------------------------- */
UPushButton:pressed,
USpinBox::up-button:pressed,
USpinBox::down-button:pressed,
Thumb[framed="true"] {
    border: 2px solid #0059d1;
}

SquareThumb[framed="true"] {
    border: 2px solid #0059d1;
}

USpinBox::up-button:pressed,
USpinBox::down-button:pressed {
    border: none;
}


/* ---------------------------------------------------------------------
   #263440  РАМКА ПАНЕЛЕЙ И ПОЛЕЙ
   Панели, кнопки, поля, спинбокс, разделитель, тултип
   Также дорожка слайдера и пунктирная рамка зоны перетаскивания
   --------------------------------------------------------------------- */
UGroupBox,
UListWidget,
UTreeView,
UTreeWidget,
UMenu,
UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
USep,
QToolTip {
    border: 1px solid #263440;
}

USlider::groove:horizontal {
    background-color: #263440;
}

WinImgSearchDropWidget {
    border: 2px dashed #263440;
}


/* ---------------------------------------------------------------------
   #30404f  РАМКА ПРИ НАВЕДЕНИИ, ЧЕКБОКСЫ, ТЕГ TRANSPARENT
   --------------------------------------------------------------------- */
UPushButton:hover,
ULineEdit:hover,
UTextEdit:hover,
USpinBox:hover,
UPushButton:pressed,
UListWidget::indicator,
UListWidget::indicator:disabled,
UCheckBox::indicator,
UTagWidget[style="transparent"] {
    border: 1px solid #30404f;
}


/* ---------------------------------------------------------------------
   #283645  ИКОНОЧНЫЕ КНОПКИ: ВЫБРАНО
   Наведение задано в блоке #1d2833
   --------------------------------------------------------------------- */
_SvgWithThemeBg[style="selected"] {
    background: #283645;
}


/* ---------------------------------------------------------------------
   #3a4b5e  ИКОНОЧНАЯ КНОПКА: НАЖАТИЕ
   --------------------------------------------------------------------- */
_SvgWithThemeBg[style="pressed"] {
    background: #3A4B5E;
}


/* ---------------------------------------------------------------------
   #0059d1  СИНИЙ АКЦЕНТ
   Основная кнопка ActiveButton, синий тег, подпись выбранной миниатюры
   --------------------------------------------------------------------- */
ActiveButton {
    background: #0059D1;
    border: 1px solid #0e69df;
}

ActiveButton:hover {
    background: #0a63dc;
}

ActiveButton:pressed {
    background: #0e69df;
    border: 1px solid #2d7be1;
}

UTagWidget[style="blue"] {
    background: #0059D1;
    border: 1px solid #156ee3;
}


/* ---------------------------------------------------------------------
   #303b46 / #3d4a56  СЕРЫЙ ТЕГ
   --------------------------------------------------------------------- */
UTagWidget[style="gray"] {
    background: #303b46;
    border: 1px solid #3d4a56;
}


/* ---------------------------------------------------------------------
   #064e3b / #10b981  ЗЕЛЁНЫЙ ТЕГ
   --------------------------------------------------------------------- */
UTagWidget[style="green"] {
    background: #064E3B;
    border: 1px solid #10B981;
}


/* ---------------------------------------------------------------------
   #8f9ba6  ПОЛЗУНОК СЛАЙДЕРА
   --------------------------------------------------------------------- */
USlider::handle:horizontal {
    background-color: #8f9ba6;
}


/* ---------------------------------------------------------------------
   rgba(40, 54, 69, 191)  ПОЛУПРОЗРАЧНЫЙ ФОН КНОПКИ «ВВЕРХ»
   --------------------------------------------------------------------- */
UpBtnLabel {
    background: rgba(40, 54, 69, 191);
}


/* ---------------------------------------------------------------------
   #7b8792  СЕРЫЙ ТЕКСТ ПОДПИСЕЙ
   --------------------------------------------------------------------- */
GrayTextLabel {
    color: #7b8792;
}


/* ---------------------------------------------------------------------
   #ffffff  ОСНОВНОЙ ТЕКСТ
   Элементы ввода, пункты списков, деревьев и меню, теги, подписи миниатюр
   --------------------------------------------------------------------- */
UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
QToolTip,
UTreeView::item,
UListWidget::item,
UTreeWidget::item,
UMenu::item,
UTagWidget {
    color: #ffffff;
}


/* =====================================================================
   3. ГЕОМЕТРИЯ (без цветов)
   ===================================================================== */

/* --- Скругления --- */
UFrame,
UBlackFrame,
UGroupBox,
UListWidget,
UTreeView,
UTreeWidget,
UMenu,
UTextEdit,
WinImgViewGraphics,
WinImageView,
WinImgSearchPreviewWidget,
Thumb {
    border-radius: 14px;
}
SquareThumb {
    border-radius: 0px;
}

UTagWidget {
    border-radius: 12px;
}

WinImgSearchDropWidget {
    border-radius: 20px;
}

UpBtnLabel {
    border-radius: 18px;
}

UPushButton,
_SvgWithThemeBg {
    border-radius: 8px;
}

ULineEdit {
    border-radius: 6px;
}

USpinBox {
    border-radius: 4px;
}

USpinBox::up-button,
USpinBox::down-button {
    border-radius: 3px;
}

UCheckBox::indicator {
    border-radius: 5px;
}

UListWidget::indicator {
    border-radius: 4px;
}

USlider::groove:horizontal {
    border-radius: 1px;
}

USlider::handle:horizontal {
    border-radius: 5px;
}


/* --- Отступы и размеры --- */
UTreeView,
UListWidget,
UTreeWidget {
    padding: 10px 2px 10px 2px;
}

UTreeView::item,
UListWidget::item,
UTreeWidget::item {
    height: 30px;
}

UMenu {
    padding: 5px 2px 5px 2px;
}

UMenu::item {
    padding: 5px 30px 5px 10px;
}

UMenu::icon {
    padding-left: 5px;
}

UMenu::indicator {
    width: 16px;
    height: 16px;
    padding-left: 5px;
}

UMenu::right-arrow {
    width: 12px;
    height: 12px;
    padding-right: 5px;
}

ULineEdit,
UTextEdit {
    padding: 5px 2px 5px 2px;
}

UPushButton {
    font-size: 11px;
    padding-left: 5px;
    padding-right: 5px;
}

UPushButton::menu-indicator {
    width: 12px;
    height: 12px;
}

USpinBox::up-button,
USpinBox::down-button {
    width: 17px;
    margin-right: 2px;
}

USpinBox::up-button {
    height: 9px;
    margin-top: 2px;
}

USpinBox::down-button {
    height: 9px;
    margin-bottom: 2px;
}

USpinBox::up-arrow,
USpinBox::down-arrow {
    width: 9px;
    height: 9px;
}

UCheckBox {
    spacing: 6px;
}

UCheckBox::indicator {
    width: 15px;
    height: 15px;
}

UListWidget::indicator {
    width: 16px;
    height: 16px;
}

USlider::groove:horizontal {
    height: 3px;
    margin: 0px;
}

USlider::handle:horizontal {
    height: 10px;
    width: 10px;
    margin: -4px 0;   /* проверить: по расчёту нужно 3.5px */
}

SearchWidLineEdit {
    padding-left: 25px;
    padding-right: 25px;
}

QToolTip {
    padding: 2px;
}

TitleTextLabel TransparentLabel {
    font-weight: bold;
    font-size: 20px;
}

MfPathTitle {                    /* проверить: grep по коду */
    font-size: 15px;
}

ThumbFilenameWid,
ThumbBlueTextWidget,
ThumbMiuzBlueTextWidget {
    font-size: 11px;
}


/* --- Иконки --- */
UMenu::indicator:checked,
UListWidget::indicator:checked,
UCheckBox::indicator:checked {
    image: url(./icons/common/checkmark_small.svg);
}

UMenu::indicator:unchecked,
UCheckBox::indicator:unchecked {
    image: none;
}

UMenu::right-arrow,
UMenu::right-arrow:selected {
    image: url("./icons/common/arrow_right.svg");
}

UPushButton::menu-indicator {
    image: url("./icons/common/arrow_down.svg");
}

USpinBox::up-arrow {
    image: url("./icons/common/arrow_up.svg");
}

USpinBox::down-arrow {
    image: url("./icons/common/arrow_down.svg");
}

UTreeView::branch:has-children:closed,
UTreeWidget::branch:has-children:closed {
    image: url(./icons/common/expand.svg);
}

UTreeView::branch:has-children:open,
UTreeWidget::branch:has-children:open {
    image: url(./icons/common/collapse.svg);
}

