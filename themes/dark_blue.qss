/* grid.py */
ThumbImgWidget {
    border-radius: 10px;
}

ThumbImgWidget[framed="false"] {
    background: transparent;
}

ThumbImgWidget[framed="true"] {
    background: #202c38;
}

ThumbWhiteTextWid {
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: 5px;
    font-size: 11px;
    color: #FFFFFF;
}

ThumbWhiteTextWid[framed="false"] {
    background: transparent;
}

ThumbWhiteTextWid[framed="true"] {
    background: #0059D1;
}

ThumbBlueTextWidget,
ThumbMiuzBlueTextWidget {
    background: transparent;
    color: #6E6E6E;
    font-size: 11px;
}


