/* ==================== TOOLTIP ==================== */

QToolTip {
    padding: 2px;
}


/* ==================== TEXT ==================== */

GrayTextLabel {
    color: #7b8792;
}

TitleTextLabel {
    font-weight: bold;
    font-size: 20px;
}

MfPathTitle {
    font-size: 15px;
}





_SvgWithThemeBg[style="base"] {
    background: transparent;
    border-radius: 8px;
}

_SvgWithThemeBg:hover[style="base"] {
    background: #283645;
    border-radius: 8px;
}

_SvgWithThemeBg[style="selected"] {
    background: #283645;
    border-radius: 8px;
}

_SvgWithThemeBg[style="pressed"] {
    background: #3A4B5E;
    border-radius: 8px;
}




