/* прозрачность */

TransparentButton,
TransparentLabel,
TransparentFrame,
TransparentWidget,
TransparentLineEdit,
TransparentTextEdit,
TransparentMenu,
TransparentScrollArea,
UGroupBox,
TransparentListWidget,
TransparentTreeWidget,
TransparentTreeView,
MacControlButton {
    background: transparent;
    border: none;
}


/* базовые виджеты */

UFrame {
    background: #ff0c1218;
    border: 1px solid #ff1d2b38;
    border-radius: 10px;
}

UBlackFrame {
    background: #000000;
    border: 1px solid transparent;
    border-radius: 10px;
}

/* основные виджеты */

UGroupBox, UTreeView, UListWidget, UTreeWidget, UMenu {
    background: #101820;
    border: 1px solid #263440;
    border-radius: 10px;
}

UTreeView::item, UListWidget::item, UTreeWidget::item, UMenu::item {
    background: transparent;
    border: none;
    color: #ffffff;
}


/* светлые виджеты должны выделяться на фоне group box, так как виджеты помещены всегда на group box */

UPushButton, ULineEdit, UTextEdit, USep, USpinBox, QToolTip {
    background: #18212a;
    border: 1px solid #263440;
    color: #ffffff;
}



/* НЕПОНЯТНО КУДА */
USpinBox::up-button,
USpinBox::down-button {
    background: none;
}



/* еще светлее виджеты */

UPushButton:hover, ULineEdit:hover, UTextEdit:hover, USpinBox:hover {
    background: #1d2833;
    border: 1px solid #30404f;
}


USpinBox::up-button, USpinBox::down-button {
    background: #1d2833;
}



UListWidget::indicator, UListWidget::indicator:disabled {
    background: #1d2833;
    border: 1px solid #30404f;
}

UCheckBox::indicator {
    background: transparent;
    border: 1px solid #30404f;
}


UTreeView::item:selected, UListWidget::item:selected, UTreeWidget::item:selected, UMenu::item:selected {
    background: #1d2833;
}

UTreeView::item:selected:!active, UListWidget::item:selected:!active, UTreeWidget::item:selected:!active {
    background: #1d2833;
}

UTreeView::branch:selected, UTreeWidget::branch:selected {
    background: #1d2833;
}




/* еще еще светлее виджеты */
UPushButton:pressed, USpinBox::up-button:pressed, USpinBox::down-button:pressed {
    background: #202c38;
    border: 1px solid #30404f;
}


USpinBox::up-button:pressed, USpinBox::down-button:pressed {
    border: none;
}



UListWidget::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
}


UCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 5px;
}



UListWidget::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
}




/* ==================== MENU ==================== */

UMenu {
    border-radius: 10px;
    padding: 5px 2px 5px 2px;
}

UMenu::item {
    padding: 5px 30px 5px 10px;
}


UMenu::icon {
    padding-left: 5px;
}

UMenu::indicator {
    width: 16px;
    height: 16px;
    padding-left: 5px;
}

UMenu::indicator:checked {
    image: url(./icons/common/checkmark_small.svg);
}

UMenu::indicator:unchecked {
    image: none;
}

UMenu::right-arrow {
    image: url("./icons/common/arrow_right.svg");
    width: 12px;
    height: 12px;
    padding-right: 5px;
}

UMenu::right-arrow:selected {
    image: url("./icons/common/arrow_right.svg");
}


/* ==================== INPUT ==================== */

ULineEdit {
    border-radius: 6px;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 5px;
    padding-bottom: 5px;
}

UTextEdit {
    border-radius: 10px;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 5px;
    padding-bottom: 5px;
}


/* ==================== TREE / LIST ==================== */

UTreeView,
UListWidget,
UTreeWidget {
    border-radius: 10px;
    padding: 10px 2px 10px 2px;
}

UTreeView::item,
UListWidget::item,
UTreeWidget::item {
    height: 30px;
}


UTreeView::branch:has-children:closed,
UTreeWidget::branch:has-children:closed {
    image: url(./icons/common/expand.svg);
}

UTreeView::branch:has-children:open,
UTreeWidget::branch:has-children:open {
    image: url(./icons/common/collapse.svg);
}





UListWidget::indicator:checked {
    image: url(./icons/common/checkmark_small.svg);
}




/* ==================== BUTTON ==================== */

UPushButton {
    font-size: 11px;
    border-radius: 8px;
    padding-right: 5px;
    padding-left: 5px;
}




UPushButton::menu-indicator {
    image: url("./icons/common/arrow_down.svg");
    width: 12px;
    height: 12px;
}


/* ==================== ACTIVE BUTTON ==================== */

ActiveButton {
    background: #0059D1;
    border: 1px solid #0e69df;
}

ActiveButton:hover {
    background: #0a63dc;
}

ActiveButton:pressed {
    background: #0e69df;
    border: 1px solid #2d7be1;
}


/* ==================== SLIDER ==================== */

USlider::groove:horizontal {
	/* Цвет самой линии (дорожки) */
	background-color: #263440;
	/* Толщина линии */
	height: 3px;
	/* Небольшое скругление краев линии */
	border-radius: 1px;
	margin: 0px;
}

USlider::handle:horizontal {
	/* Цвет кружочка (ползунка) */
	background-color: #8f9ba6;
	/* Размеры задают квадрат 10x10 пикселей */
	height: 10px;
	width: 10px;
	/* Радиус скругления, равный половине ширины/высоты (10/2 = 5), делает из квадрата идеальный круг */
	border-radius: 5px;
	/* Смещаем ползунок вверх и вниз за пределы тонкой дорожки. 
	   Математика: (Высота ползунка 10px - Высота дорожки 3px) / 2 = 3.5px. 
	   Округление до 4px (или 3px) центрирует кружок относительно линии. */
	margin: -4px 0;
}


/* ==================== SPINBOX ==================== */



USpinBox {
    border-radius: 4px;
}

USpinBox::up-button,
USpinBox::down-button {
    background: #18212a;
    width: 17px;
    margin-right: 2px;
    border-radius: 3px;
}

USpinBox::up-button {
    height: 9px;
    margin-top: 2px;
}

USpinBox::down-button {
    height: 9px;
    margin-bottom: 2px;
}


USpinBox::up-arrow {
    image: url("./icons/common/arrow_up.svg");
    width: 9px;
    height: 9px;
}

USpinBox::down-arrow {
    image: url("./icons/common/arrow_down.svg");
    width: 9px;
    height: 9px;
}


/* ==================== CHECK BOX ==================== */

UCheckBox {
    background: transparent;
    spacing: 6px;
}


UCheckBox::indicator:checked {
    image: url(./icons/common/checkmark_small.svg);
}

UCheckBox::indicator:unchecked {
    image: none;
}


/* ==================== TAG ==================== */

UTagWidget {
    border-radius: 12px;
    color: #ffffff;
}

UTagWidget[style="blue"] {
    background: #0059D1;
    border: 1px solid #156ee3;
}

UTagWidget[style="gray"] {
    background: #303b46;
    border: 1px solid #3d4a56;
}

UTagWidget[style="transparent"] {
    background: transparent;
    border: 1px solid #30404f;
}

UTagWidget[style="green"] {
    background: #064E3B;
    border: 1px solid #10B981;
}

