/* =====================================================================
   СВЕТЛАЯ ТЕМА

   Структура совпадает с тёмной темой (dark.qss): те же разделы и
   те же селекторы. Различаются только значения цветов.

   Правило: при одинаковой специфичности побеждает правило, написанное
   позже. Основа идёт первой, цвета перекрывают её.

   Палитра (по ролям):
     Фоны
       #ffffff                  просмотр изображений, превью поиска
       #f4f6f8                  UFrame
       #fafbfc                  панели: GroupBox, списки, деревья, меню
       #eef2f6                  зона перетаскивания
       #f1f4f7                  кнопки, поля, спинбокс, разделитель,
                                тултип, карточка миниатюры
       rgba(255, 255, 255, 191) кнопка «вверх»
       rgba(0, 0, 0, 150)       затемнение окна
     Рамки
       #d0d9e3                  рамка UFrame, панелей и полей, дорожка
                                слайдера, полоса прокрутки
     Состояния
       #e3eaf2                  наведение, выделение, отметка в списке
       #d5dfeb                  нажатая стрелка спинбокса
       #dde6f0                  иконочная кнопка: выбрано
       #c9d5e3                  иконочная кнопка: нажатие
       #b8c4d2                  рамка при наведении, чекбокс, полоса
                                прокрутки при наведении
       #9aa8b8                  полоса прокрутки: нажатие
     Текст
       #1a2430                  основной текст
       #5f6d7b                  серый текст подписей
     Акцент
       #0059d1                  ActiveButton, синий тег, рамка миниатюры
       #0a63dc                  ActiveButton: наведение
       #0a4fb8 / #083f94        ActiveButton: граница / нажатие
     Теги
       #e5e9ee / #c5ced9        серый (фон / рамка)
       #d1fae5 / #10b981        зелёный
       #fef3c7 / #ca8a04        жёлтый
       #fee2e2 / #ef4444        красный
     Слайдер
       #5f6d7b                  ползунок
     Красная кнопка
       #d93a44 / #e0525b        текст / рамка
       #fdecee                  наведение: фон
       #f8d7db                  нажатие: фон

   ВАЖНО: при смене цвета UListWidget::item:selected или UMenu::item:selected
   поменяйте sel_color в system/themes.py (класс LightTreeTheme).
   Выделение дерева (UTreeView, UTreeWidget) рисует делегат, здесь его нет.
   ===================================================================== */


/* =====================================================================
   1. ПРОЗРАЧНАЯ ОСНОВА
   Все виджеты стартуют прозрачными и без рамки.
   ===================================================================== */

TransparentButton,
TransparentLabel,
TransparentFrame,
TransparentWidget,
TransparentLineEdit,
TransparentTextEdit,
TransparentMenu,
TransparentScrollArea,
MacControlButton,                /* проверить: grep по коду */
UFrame,
UBlackFrame,
UGroupBox,
UTreeView,
UListWidget,
UTreeWidget,
UMenu,
UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
USpinBox::up-button,
USpinBox::down-button,
USep,
UCheckBox,
UCheckBox::indicator,
UTagWidget,
UpBtnLabel,
ImgViewSvg,
_SvgWithThemeBg {
    background: transparent;
    border: none;
    color: #1a2430;
}

/* Рамка миниатюры всегда есть, но прозрачна:
   при выделении меняется только цвет, размер не сдвигается. */
Thumb,
SquareThumb {
    border: 2px solid transparent;
}

UTreeView::item,
UListWidget::item,
UTreeWidget::item,
UMenu::item {
    background: transparent;
    border: none;
}


/* =====================================================================
   2. ЦВЕТА
   ===================================================================== */

/* ---------------------------------------------------------------------
   2.1 ФОНЫ
   --------------------------------------------------------------------- */

/* Светлые области: просмотр изображений, превью поиска */
UBlackFrame,
WinImgViewGraphics,
WinImageView,
WinImgSearchPreviewWidget {
    background: #ffffff;
}

/* Формат #AARRGGBB: ff в начале — полная непрозрачность */
UFrame {
    background: #fff4f6f8;
}

UGroupBox,
UListWidget,
UTreeView,
UTreeWidget,
UMenu {
    background: #fafbfc;
}

WinImgSearchDropWidget {
    background: #eef2f6;
}

UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
USep,
QToolTip,
ThumbImgWidget {
    background: #f1f4f7;
}

UpBtnLabel {
    background: rgba(255, 255, 255, 191);
}

/* Затемнение окна, когда поверх открыто другое UMainWindow */
UMainWinOverlay {
    background: rgba(0, 0, 0, 150);
}


/* ---------------------------------------------------------------------
   2.2 РАМКИ
   --------------------------------------------------------------------- */

UBlackFrame {
    border: 1px solid transparent;
}

UFrame {
    border: 1px solid #ffd0d9e3;
}

UGroupBox,
UListWidget,
UTreeView,
UTreeWidget,
UMenu,
UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
USep,
QToolTip {
    border: 1px solid #d0d9e3;
}

WinImgSearchDropWidget {
    border: 2px dashed #d0d9e3;
}


/* ---------------------------------------------------------------------
   2.3 СОСТОЯНИЯ: наведение, выделение, нажатие
   --------------------------------------------------------------------- */

/* Наведение на поля, кнопки, спинбокс */
UPushButton:hover,
ULineEdit:hover,
UTextEdit:hover,
USpinBox:hover {
    background: #e3eaf2;
    border: 1px solid #b8c4d2;
}

_SvgWithThemeBg:hover[style="base"] {
    background: #e3eaf2;
}

/* Отметка в списке */
UListWidget::indicator,
UListWidget::indicator:disabled {
    background: #e3eaf2;
    border: 1px solid #b8c4d2;
}

/* Выделение пунктов списков и меню */
UListWidget::item:selected,
UListWidget::item:selected:!active,
UMenu::item:selected {
    background: #e3eaf2;
}

/* Нажатие */
UPushButton:pressed {
    border: 1px solid #b8c4d2;
}

USpinBox::up-button:pressed,
USpinBox::down-button:pressed {
    background: #d5dfeb;
    border: none;
}

/* Иконочные кнопки */
_SvgWithThemeBg[style="selected"] {
    background: #dde6f0;
}

_SvgWithThemeBg[style="pressed"] {
    background: #c9d5e3;
}

/* Выбранная миниатюра: меняется только цвет рамки, размер не меняется */
Thumb[framed="true"],
SquareThumb[framed="true"] {
    border: 2px solid #0059d1;
}


/* ---------------------------------------------------------------------
   2.4 ПОЛОСА ПРОКРУТКИ
   Фон дорожки прозрачный, ползунок: обычный / наведение / нажатие.
   --------------------------------------------------------------------- */

QScrollBar {
    background: transparent;
    border: none;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #d0d9e3;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #b8c4d2;
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background: #9aa8b8;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}


/* ---------------------------------------------------------------------
   2.5 ТЕКСТ
   --------------------------------------------------------------------- */

UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
QToolTip,
UTreeView::item,
UListWidget::item,
UTreeWidget::item,
UMenu::item,
UTagWidget {
    color: #1a2430;
}

GrayTextLabel {
    color: #5f6d7b;
}

CalendarDaySelectedText {
    color: #ffffff;
}


/* ---------------------------------------------------------------------
   2.6 АКЦЕНТ: основная кнопка
   --------------------------------------------------------------------- */

ActiveButton {
    background: #0059d1;
    border: 1px solid #0a4fb8;
    color: #ffffff;
}

ActiveButton:hover {
    background: #0a63dc;
}

ActiveButton:pressed {
    background: #0a4fb8;
    border: 1px solid #083f94;
}


/* ---------------------------------------------------------------------
   2.7 ТЕГИ
   Текст по умолчанию — из блока 2.5. Цвета тегов задают фон,
   рамку и текст вручную, потому что светлые варианты отличаются от тёмных.
   --------------------------------------------------------------------- */

UTagWidget[style="blue"] {
    background: #0059d1;
    border: 1px solid #0a4fb8;
    color: #ffffff;
}

UTagWidget[style="gray"] {
    background: #e5e9ee;
    border: 1px solid #c5ced9;
    color: #1a2430;
}

UTagWidget[style="green"] {
    background: #d1fae5;
    border: 1px solid #10b981;
    color: #065f46;
}

UTagWidget[style="yellow"] {
    background: #fef3c7;
    border: 1px solid #ca8a04;
    color: #713f12;
}

UTagWidget[style="red"] {
    background: #fee2e2;
    border: 1px solid #ef4444;
    color: #991b1b;
}

UTagWidget[style="transparent"] {
    border: 1px solid #b8c4d2;
}


/* ---------------------------------------------------------------------
   2.8 СЛАЙДЕР
   --------------------------------------------------------------------- */

USlider::groove:horizontal {
    background-color: #d0d9e3;
}

USlider::handle:horizontal {
    background-color: #5f6d7b;
}


/* ---------------------------------------------------------------------
   2.9 ОСОБЫЕ КНОПКИ
   --------------------------------------------------------------------- */

RedButton {
    color: #d93a44;
    background: transparent;
    border: 1px solid #e0525b;
}

RedButton:hover {
    background: #fdecee;
    border: 1px solid #d93a44;
}

RedButton:pressed {
    background: #f8d7db;
    border: 1px solid #d93a44;
}


/* =====================================================================
   3. ГЕОМЕТРИЯ (без цветов)
   ===================================================================== */

/* --- Скругления --- */
UFrame,
UBlackFrame,
UGroupBox,
UListWidget,
UTreeView,
UTreeWidget,
UMenu,
UTextEdit,
WinImgViewGraphics,
WinImageView,
WinImgSearchPreviewWidget,
Thumb,
SquareThumb,
UMainWinOverlay {
    border-radius: 8px;
}

ThumbImgWidget {
    border-radius: 6px;
}

UTagWidget {
    border-radius: 12px;
}

WinImgSearchDropWidget {
    border-radius: 20px;
}

UpBtnLabel {
    border-radius: 18px;
}

UPushButton,
_SvgWithThemeBg {
    border-radius: 8px;
}

ULineEdit {
    border-radius: 6px;
}

USpinBox {
    border-radius: 4px;
}

USpinBox::up-button,
USpinBox::down-button {
    border-radius: 3px;
}

UCheckBox::indicator {
    border-radius: 5px;
}

UListWidget::indicator {
    border-radius: 4px;
}

USlider::groove:horizontal {
    border-radius: 1px;
}

USlider::handle:horizontal {
    border-radius: 5px;
}

/* Значение совпадает с sel_radius в system/themes.py (LightTreeTheme) */
UListWidget::item:selected,
UListWidget::item:selected:!active,
UMenu::item:selected {
    border-radius: 6px;
}


/* --- Отступы и размеры --- */
UTreeView,
UListWidget,
UTreeWidget {
    padding: 10px 2px 10px 2px;
}

UTreeView::item,
UListWidget::item,
UTreeWidget::item {
    height: 30px;
}

UMenu {
    padding: 5px 2px 5px 2px;
}

UMenu::item {
    padding: 5px 30px 5px 10px;
}

UMenu::icon {
    padding-left: 5px;
}

UMenu::indicator {
    width: 16px;
    height: 16px;
    padding-left: 5px;
}

UMenu::right-arrow {
    width: 12px;
    height: 12px;
    padding-right: 5px;
}

ULineEdit,
UTextEdit {
    padding: 5px 2px 5px 2px;
}

UPushButton {
    font-size: 11px;
    padding-left: 5px;
    padding-right: 5px;
}

UPushButton::menu-indicator {
    width: 12px;
    height: 12px;
}

USpinBox::up-button,
USpinBox::down-button {
    width: 17px;
    margin-right: 2px;
}

USpinBox::up-button {
    height: 9px;
    margin-top: 2px;
}

USpinBox::down-button {
    height: 9px;
    margin-bottom: 2px;
}

USpinBox::up-arrow,
USpinBox::down-arrow {
    width: 9px;
    height: 9px;
}

UCheckBox {
    spacing: 6px;
}

UCheckBox::indicator {
    width: 15px;
    height: 15px;
}

UListWidget::indicator {
    width: 16px;
    height: 16px;
}

USlider::groove:horizontal {
    height: 3px;
    margin: 0px;
}

USlider::handle:horizontal {
    height: 10px;
    width: 10px;
    margin: -4px 0;   /* проверить: по расчёту нужно 3.5px */
}

SearchWidLineEdit {
    padding-left: 25px;
    padding-right: 25px;
}

QToolTip {
    padding: 2px;
}

TitleTextLabel TransparentLabel {
    font-weight: bold;
    font-size: 20px;
}

MfPathTitle {                    /* проверить: grep по коду */
    font-size: 15px;
}

ThumbFilenameWid,
ThumbBlueTextWidget,
ThumbMiuzBlueTextWidget {
    font-size: 11px;
}


/* --- Полоса прокрутки --- */
QScrollBar:vertical {
    width: 14px;
    margin: 4px 3px 4px 3px;
}

QScrollBar:horizontal {
    height: 14px;
    margin: 3px 4px 3px 4px;
}

QScrollBar::handle:vertical {
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
    border: none;
    background: none;
}


/* --- Иконки --- */
UMenu::indicator:checked,
UListWidget::indicator:checked,
UCheckBox::indicator:checked {
    image: url(./icons/gray/checkmark_gray.svg);
}

UMenu::indicator:unchecked,
UCheckBox::indicator:unchecked {
    image: none;
}

UMenu::right-arrow,
UMenu::right-arrow:selected {
    image: url("./icons/gray/arrow_right_gray.svg");
}

UPushButton::menu-indicator {
    image: url("./icons/gray/arrow_down_gray.svg");
}

USpinBox::up-arrow {
    image: url("./icons/gray/arrow_up_gray.svg");
}

USpinBox::down-arrow {
    image: url("./icons/gray/arrow_down_gray.svg");
}

UTreeView::branch:has-children:closed,
UTreeWidget::branch:has-children:closed {
    image: url(./icons/gray/expand_gray.svg);
}

UTreeView::branch:has-children:open,
UTreeWidget::branch:has-children:open {
    image: url(./icons/gray/collapse_gray.svg);
}