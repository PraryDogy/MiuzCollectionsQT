/* =====================================================================
   СВЕТЛАЯ ТЕМА

   Порядок файла:
   1. Прозрачная основа: все виджеты стартуют прозрачными и без рамки.
   2. Цвета по группам: фон, рамка, текст. Каждый цвет в одном блоке.
   3. Геометрия: скругления, отступы, размеры, шрифты, иконки.

   Правило: при одинаковой специфичности побеждает правило, написанное
   позже. Поэтому основа идёт первой, а цвета перекрывают её.

   Палитра:
   #ffffff  фон просмотра изображений, превью поиска
   #f4f6f8  фон UFrame
   #fafbfc  фон панелей (GroupBox, списки, деревья, меню)
   #eef2f6  фон зоны перетаскивания
   #f1f4f7  фон кнопок, полей ввода, спинбокса, тултипа, карточки миниатюры
   #e3eaf2  наведение, выделение, отметка в списке
   #d5dfeb  нажатие кнопки
   #d0d9e3  рамка панелей и полей, дорожка слайдера, ползунок полосы прокрутки
   #dde6f0  иконочные кнопки: выбрано
   #b8c4d2  рамка при наведении, чекбоксы, полоса прокрутки при наведении
   #c9d5e3  иконочная кнопка: нажатие
   #9aa8b8  полоса прокрутки: нажатие
   #0059d1  синий акцент: ActiveButton, синий тег, рамка выбранной миниатюры
   #e5e9ee  серый тег
   #d1fae5  зелёный тег
   #5f6d7b  серый текст подписей, ползунок слайдера
   #5c6670  серый текст миниатюр
   #1a2430  основной текст
   ===================================================================== */


/* =====================================================================
   1. ПРОЗРАЧНАЯ ОСНОВА
   ===================================================================== */

TransparentButton,
TransparentLabel,
TransparentFrame,
TransparentWidget,
TransparentLineEdit,
TransparentTextEdit,
TransparentMenu,
TransparentScrollArea,
MacControlButton,                /* проверить: grep по коду */
UFrame,
UBlackFrame,
UGroupBox,
UTreeView,
UListWidget,
UTreeWidget,
UMenu,
UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
USpinBox::up-button,
USpinBox::down-button,
USep,
UCheckBox,
UCheckBox::indicator,
UTagWidget,
UpBtnLabel,
ImgViewSvg,
_SvgWithThemeBg {
    background: transparent;
    border: none;
    color: #000000;
}

/* Рамка миниатюры всегда присутствует, но прозрачна.
   Так при выделении меняется только цвет, размер содержимого не сдвигается. */
Thumb,
SquareThumb {
    border: 2px solid transparent;
}

UTreeView::item,
UListWidget::item,
UTreeWidget::item,
UMenu::item {
    background: transparent;
    border: none;
}


/* =====================================================================
   2. ЦВЕТА ПО ГРУППАМ
   ===================================================================== */

/* ---------------------------------------------------------------------
   #ffffff  БЕЛЫЙ ФОН
   Окно просмотра, превью поиска
   --------------------------------------------------------------------- */
UBlackFrame,
WinImgViewGraphics,
WinImageView,
WinImgSearchPreviewWidget {
    background: #ffffff;
}

UBlackFrame {
    border: 1px solid transparent;
}


/* ---------------------------------------------------------------------
   #f4f6f8  ФОН UFrame
   --------------------------------------------------------------------- */
UFrame {
    background: #fff4f6f8;
    border: 1px solid #ffd0d9e3;
}


/* ---------------------------------------------------------------------
   #fafbfc  ФОН ПАНЕЛЕЙ
   --------------------------------------------------------------------- */
UGroupBox,
UListWidget,
UTreeView,
UTreeWidget,
UMenu {
    background: #fafbfc;
}


/* ---------------------------------------------------------------------
   #eef2f6  ФОН ЗОНЫ ПЕРЕТАСКИВАНИЯ
   --------------------------------------------------------------------- */
WinImgSearchDropWidget {
    background: #eef2f6;
}


/* ---------------------------------------------------------------------
   #f1f4f7  ФОН ЭЛЕМЕНТОВ ВВОДА И КАРТОЧКИ МИНИАТЮРЫ
   --------------------------------------------------------------------- */
UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
USep,
QToolTip,
ThumbImgWidget {
    background: #f1f4f7;
}


/* ---------------------------------------------------------------------
   #e3eaf2  НАВЕДЕНИЕ, ВЫДЕЛЕНИЕ, ОТМЕТКА В СПИСКЕ
   ВАЖНО: при смене цвета UListWidget::item:selected или UMenu::item:selected
   поменяйте sel_color в system/themes.py (класс LightTreeTheme).
   Выделение дерева (UTreeView, UTreeWidget) рисует делегат, здесь его нет.
   --------------------------------------------------------------------- */
UPushButton:hover,
ULineEdit:hover,
UTextEdit:hover,
USpinBox:hover,
_SvgWithThemeBg:hover[style="base"],
UListWidget::indicator,
UListWidget::indicator:disabled,
UListWidget::item:selected,
UListWidget::item:selected:!active,
UMenu::item:selected {
    background: #e3eaf2;
}


/* ---------------------------------------------------------------------
   #d5dfeb  НАЖАТИЕ КНОПКИ
   Нажатая стрелка спинбокса без фона: её фон даёт поле.
   --------------------------------------------------------------------- */
UPushButton:pressed {
    background: #d5dfeb;
    border: 2px solid #0059d1;
}

USpinBox::up-button:pressed,
USpinBox::down-button:pressed {
    border: none;
}


/* ---------------------------------------------------------------------
   #0059d1  РАМКА ВЫБРАННОЙ МИНИАТЮРЫ
   Размер содержимого не меняется: рамка задана в блоке 1,
   здесь меняется только цвет.
   --------------------------------------------------------------------- */
Thumb[framed="true"],
SquareThumb[framed="true"] {
    border: 2px solid #0059d1;
}


/* ---------------------------------------------------------------------
   #d0d9e3  РАМКА ПАНЕЛЕЙ И ПОЛЕЙ
   --------------------------------------------------------------------- */
UGroupBox,
UListWidget,
UTreeView,
UTreeWidget,
UMenu,
UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
USep,
QToolTip {
    border: 1px solid #d0d9e3;
}

USlider::groove:horizontal {
    background-color: #d0d9e3;
}

WinImgSearchDropWidget {
    border: 2px dashed #d0d9e3;
}


/* ---------------------------------------------------------------------
   #b8c4d2  РАМКА ПРИ НАВЕДЕНИИ, ЧЕКБОКСЫ
   --------------------------------------------------------------------- */
UPushButton:hover,
ULineEdit:hover,
UTextEdit:hover,
USpinBox:hover,
UPushButton:pressed,
UListWidget::indicator,
UListWidget::indicator:disabled,
UCheckBox::indicator {
    border: 1px solid #b8c4d2;
}


/* ---------------------------------------------------------------------
   ИКОНОЧНЫЕ КНОПКИ
   --------------------------------------------------------------------- */
_SvgWithThemeBg[style="selected"] {
    background: #dde6f0;
}

_SvgWithThemeBg[style="pressed"] {
    background: #c9d5e3;
}


/* ---------------------------------------------------------------------
   #d0d9e3 / #b8c4d2 / #9aa8b8  ПОЛОСА ПРОКРУТКИ
   Ползунок: обычный, при наведении, при нажатии.
   Фон дорожки прозрачный, чтобы полоса не выделялась на панели.
   --------------------------------------------------------------------- */
QScrollBar {
    background: transparent;
    border: none;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #d0d9e3;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #b8c4d2;
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background: #9aa8b8;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}


/* ---------------------------------------------------------------------
   #1a2430  ОСНОВНОЙ ТЕКСТ
   --------------------------------------------------------------------- */
UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
QToolTip,
UTreeView::item,
UListWidget::item,
UTreeWidget::item,
UMenu::item {
    color: #1a2430;
}


/* ---------------------------------------------------------------------
   #0059d1  СИНИЙ АКЦЕНТ
   --------------------------------------------------------------------- */
ActiveButton {
    background: #0059d1;
    border: 1px solid #0a4fb8;
    color: #ffffff;
}

ActiveButton:hover {
    background: #0a63dc;
}

ActiveButton:pressed {
    background: #0a4fb8;
    border: 1px solid #083f94;
}

UTagWidget[style="blue"] {
    background: #0059d1;
    border: 1px solid #0a4fb8;
    color: #ffffff;
}


/* ---------------------------------------------------------------------
   СЕРЫЙ ТЕГ
   --------------------------------------------------------------------- */
UTagWidget[style="gray"] {
    background: #e5e9ee;
    border: 1px solid #c5ced9;
    color: #1a2430;
}


/* ---------------------------------------------------------------------
   ЗЕЛЁНЫЙ ТЕГ
   --------------------------------------------------------------------- */
UTagWidget[style="green"] {
    background: #d1fae5;
    border: 1px solid #10b981;
    color: #065f46;
}


/* ---------------------------------------------------------------------
   ПОЛЗУНОК СЛАЙДЕРА
   --------------------------------------------------------------------- */
USlider::handle:horizontal {
    background-color: #5f6d7b;
}


/* ---------------------------------------------------------------------
   ПОЛУПРОЗРАЧНЫЙ ФОН КНОПКИ «ВВЕРХ»
   --------------------------------------------------------------------- */
UpBtnLabel {
    background: rgba(255, 255, 255, 191);
}


/* ---------------------------------------------------------------------
   #5f6d7b  СЕРЫЙ ТЕКСТ ПОДПИСЕЙ
   --------------------------------------------------------------------- */
GrayTextLabel {
    color: #5f6d7b;
}

CalendarDaySelectedText {
    color: #ffffff;
}



/* =====================================================================
   3. ГЕОМЕТРИЯ (без цветов)
   ===================================================================== */

/* --- Скругления --- */
UFrame,
UBlackFrame,
UGroupBox,
UListWidget,
UTreeView,
UTreeWidget,
UMenu,
UTextEdit,
WinImgViewGraphics,
WinImageView,
WinImgSearchPreviewWidget,
Thumb,
SquareThumb {
    border-radius: 8px;
}

/* карточка картинки внутри миниатюры */
ThumbImgWidget {
    border-radius: 6px;
}

UTagWidget {
    border-radius: 12px;
}

WinImgSearchDropWidget {
    border-radius: 20px;
}

UpBtnLabel {
    border-radius: 18px;
}

UPushButton,
_SvgWithThemeBg {
    border-radius: 8px;
}

ULineEdit {
    border-radius: 6px;
}

USpinBox {
    border-radius: 4px;
}

USpinBox::up-button,
USpinBox::down-button {
    border-radius: 3px;
}

UCheckBox::indicator {
    border-radius: 5px;
}

UListWidget::indicator {
    border-radius: 4px;
}

USlider::groove:horizontal {
    border-radius: 1px;
}

USlider::handle:horizontal {
    border-radius: 5px;
}


/* --- Скругление выделения пунктов списков и меню ---
   Значение совпадает с sel_radius в system/themes.py (LightTreeTheme). */
UListWidget::item:selected,
UListWidget::item:selected:!active,
UMenu::item:selected {
    border-radius: 8px;
}


/* --- Отступы и размеры --- */
UTreeView,
UListWidget,
UTreeWidget {
    padding: 10px 2px 10px 2px;
}

UTreeView::item,
UListWidget::item,
UTreeWidget::item {
    height: 30px;
}

UMenu {
    padding: 5px 2px 5px 2px;
}

UMenu::item {
    padding: 5px 30px 5px 10px;
}

UMenu::icon {
    padding-left: 5px;
}

UMenu::indicator {
    width: 16px;
    height: 16px;
    padding-left: 5px;
}

UMenu::right-arrow {
    width: 12px;
    height: 12px;
    padding-right: 5px;
}

ULineEdit,
UTextEdit {
    padding: 5px 2px 5px 2px;
}

UPushButton {
    font-size: 11px;
    padding-left: 5px;
    padding-right: 5px;
}

UPushButton::menu-indicator {
    width: 12px;
    height: 12px;
}

USpinBox::up-button,
USpinBox::down-button {
    width: 17px;
    margin-right: 2px;
}

USpinBox::up-button {
    height: 9px;
    margin-top: 2px;
}

USpinBox::down-button {
    height: 9px;
    margin-bottom: 2px;
}

USpinBox::up-arrow,
USpinBox::down-arrow {
    width: 9px;
    height: 9px;
}

UCheckBox {
    spacing: 6px;
}

UCheckBox::indicator {
    width: 15px;
    height: 15px;
}

UListWidget::indicator {
    width: 16px;
    height: 16px;
}

USlider::groove:horizontal {
    height: 3px;
    margin: 0px;
}

USlider::handle:horizontal {
    height: 10px;
    width: 10px;
    margin: -4px 0;   /* проверить: по расчёту нужно 3.5px */
}

SearchWidLineEdit {
    padding-left: 25px;
    padding-right: 25px;
}

QToolTip {
    padding: 2px;
}

TitleTextLabel TransparentLabel {
    font-weight: bold;
    font-size: 20px;
}

MfPathTitle {                    /* проверить: grep по коду */
    font-size: 15px;
}

ThumbFilenameWid,
ThumbBlueTextWidget,
ThumbMiuzBlueTextWidget {
    font-size: 11px;
}


/* --- Полоса прокрутки --- */
QScrollBar:vertical {
    width: 14px;
    margin: 4px 3px 4px 3px;
}

QScrollBar:horizontal {
    height: 14px;
    margin: 3px 4px 3px 4px;
}

QScrollBar::handle:vertical {
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
    border: none;
    background: none;
}


/* --- Иконки --- */
UMenu::indicator:checked,
UListWidget::indicator:checked,
UCheckBox::indicator:checked {
    image: url(./icons/common/checkmark_small.svg);
}

UMenu::indicator:unchecked,
UCheckBox::indicator:unchecked {
    image: none;
}

UMenu::right-arrow,
UMenu::right-arrow:selected {
    image: url("./icons/common/arrow_right.svg");
}

UPushButton::menu-indicator {
    image: url("./icons/common/arrow_down.svg");
}

USpinBox::up-arrow {
    image: url("./icons/common/arrow_up.svg");
}

USpinBox::down-arrow {
    image: url("./icons/common/arrow_down.svg");
}

UTreeView::branch:has-children:closed,
UTreeWidget::branch:has-children:closed {
    image: url(./icons/common/expand_r.svg);
}

UTreeView::branch:has-children:open,
UTreeWidget::branch:has-children:open {
    image: url(./icons/common/collapse_r.svg);
}