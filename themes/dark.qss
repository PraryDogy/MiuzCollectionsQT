/* =====================================================================
   ТЁМНАЯ ТЕМА (подход VS Code)

   Слои различаются тонкими рамками и небольшой разницей яркости.
   Цвет используется только для действий и состояний: основная кнопка,
   значение точности, активная зона перетаскивания, выделение.

   Каждый виджет описан отдельным блоком: цвета и геометрия вместе.
   Перед блоком комментарий PY: что из геометрии стоит вынести в код.

   Палитра (по ролям):
     Фоны
       #000000                  просмотр изображений, превью поиска
       #0b1015                  окно (UMainWindow)
       #0f151b                  UFrame
       #131b23                  UGroupBox, списки, деревья, меню
       #161f28                  SubGroup
       #1a232d                  кнопки, поля, спинбокс, тултип, карточка
       #111a22                  зона перетаскивания
       rgba(40, 54, 69, 191)    кнопка «вверх»
       rgba(0, 0, 0, 150)       затемнение окна
     Рамки
       #243240                  рамка UFrame, групп, списков, дорожки
       #2f3f4f                  рамка кнопок, полей, спинбокса
       #3a4d61                  рамка при наведении
     Состояния
       #1d2833                  наведение строк, выделение, отметка
       #212c38                  наведение кнопок и полей
       #283645                  нажатие, иконочная кнопка: выбрано
       #465a70                  полоса прокрутки: нажатие
     Текст
       #ffffff                  основной текст
       #7b8792                  серый текст подписей
     Акцент (только действия и состояния)
       #0a6ce0                  ActiveButton, синий тег
       #1a7cf0                  ActiveButton: наведение и рамка
       #0859bd                  ActiveButton: нажатие
       #2f5f96                  пунктирная рамка зоны перетаскивания
     Теги
       #303b46 / #3d4a56        серый
       #064e3b / #10b981        зелёный
       #3a2c12 / #6b5420        жёлтый
       #7f1d1d / #ef4444        красный
     Слайдер
       #8f9ba6                  ползунок

   ВАЖНО: цвет выделения списков (#1d2833) дублируется в system/themes.py,
   класс DarkTreeTheme.sel_color. При смене цвета меняйте в обоих местах.
   Выделение дерева (UTreeView, UTreeWidget) рисует делегат, в QSS его нет.
   ===================================================================== */


/* =====================================================================
   ПРОЗРАЧНЫЕ ОБЁРТКИ
   ===================================================================== */

/* PY: не требуется, чисто стилевая обёртка. */
TransparentButton {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
TransparentFrame {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
TransparentWidget {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
TransparentLineEdit {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
TransparentTextEdit {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
TransparentMenu {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
TransparentScrollArea {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
/* проверить: grep по коду, используется ли класс */
MacControlButton {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
ImgViewSvg {
    background: transparent;
    border: none;
    color: #ffffff;
}


/* =====================================================================
   ОКНО, ФРЕЙМЫ И ПАНЕЛИ
   ===================================================================== */

/* PY: фон окна задаётся здесь, а не в коде.
   Если класс окна называется иначе, поправьте имя селектора. */
UMainWindow {
    background: #0b1015;
    border: none;
    color: #ffffff;
}

/* PY: внутренние отступы в layout — setContentsMargins.
   Размер рамки и скругление можно оставить здесь. */
UFrame {
    background: #0f151b;
    border: 1px solid #243240;
    border-radius: 8px;
    color: #ffffff;
}

/* PY: размер просмотрщика задавать через setMinimumSize в коде,
   рамка прозрачна, чтобы не было сдвига при изменении. */
UBlackFrame {
    background: #000000;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #ffffff;
}

/* PY: отступы содержимого группы — setContentsMargins у layout. */
UGroupBox {
    background: #131b23;
    border: 1px solid #314456;
    border-radius: 8px;
    color: #ffffff;
}

/* PY: отступы содержимого — setContentsMargins у layout, как у UGroupBox.
   Вложенная группа: фон чуть светлее, рамка та же. */
SubGroup {
    background: #161f28;
    border: 1px solid #243240;
    border-radius: 8px;
    color: #ffffff;
}

/* PY: высоту разделителя задать setFixedHeight(1).
   Цвета и рамка остаются в QSS. */
USep {
    background: #1a232d;
    border: 1px solid #243240;
    color: #ffffff;
}

/* PY: размер миниатюры — setFixedSize в коде.
   Рамка остаётся в QSS, потому что меняется при выделении. */
Thumb {
    border-radius: 8px;
}

Thumb[framed="noframe"] {
    border: 2px solid transparent;
}

Thumb[framed="frame"] {
    border: 2px solid #1a7cf0;
}

/* PY: размер плитки — setFixedSize, отступы — setContentsMargins. */
ThumbImgWidget {
    background: #1a232d;
    border-radius: 6px;
}

/* PY: размер шрифта 11px — QFont в коде. */
ThumbFilenameWid {
    font-size: 11px;
}

/* PY: размер шрифта 11px — QFont в коде. */
ThumbBlueTextWidget {
    font-size: 11px;
}

/* PY: размер шрифта 11px — QFont в коде. */
ThumbMiuzBlueTextWidget {
    font-size: 11px;
}

/* PY: размер шрифта 20px и жирность — QFont в коде. */
_TitleTextLabel {
    font-weight: bold;
    font-size: 20px;
}

/* PY: размер шрифта 15px — QFont в коде. */
/* проверить: grep по коду, используется ли класс */
MfPathTitle {
    font-size: 15px;
}

/* Чёрные области: просмотр изображений, превью поиска */

/* PY: размер области — setMinimumSize, радиус оставить здесь. */
WinImgViewGraphics {
    background: #000000;
    border-radius: 8px;
}

/* PY: размер области — setMinimumSize, радиус оставить здесь. */
WinImageView {
    background: #000000;
    border-radius: 8px;
}

/* PY: размер области — setMinimumSize, радиус оставить здесь. */
/* WinImgSearchPreviewWidget {
    background: #111a22;
    border: 2px dashed #243a52;
    border-radius: 8px;
} */

/* PY: размер и пунктирная рамка оставить здесь,
   отступы внутри — setContentsMargins у layout.
   Рамка приглушённая: зона выделяется формой, а не яркостью. */
WinImgSearchDropWidget {
    background: #111a22;
    border: 2px dashed #243a52;
    border-radius: 8px;
}


/* PY: размер кнопки «вверх» — setFixedSize (например 36x36),
   радиус 18px даёт круг. */
UpBtnLabel {
    background: rgba(40, 54, 69, 191);
    border: none;
    border-radius: 18px;
    color: #ffffff;
}

/* PY: затемнение на всё окно — setGeometry по размеру родителя в коде. */
UMainWinOverlay {
    background: rgba(0, 0, 0, 150);
    border-radius: 8px;
}


/* =====================================================================
   КНОПКИ
   ===================================================================== */

/* PY: минимальные размеры — setMinimumHeight / setMinimumWidth.
   Отступы текста оставить здесь. */
UPushButton {
    background: #1a232d;
    border: 1px solid #2f3f4f;
    border-radius: 8px;
    color: #ffffff;
    font-size: 11px;
    padding-left: 5px;
    padding-right: 5px;
}

UPushButton:hover {
    background: #212c38;
    border: 1px solid #3a4d61;
}

UPushButton:pressed {
    background: #283645;
    border: 1px solid #3a4d61;
}

/* PY: размер стрелки меню — sub-control, остаётся в QSS. */
UPushButton::menu-indicator {
    width: 12px;
    height: 12px;
    image: url("./icons/gray/arrow_down.svg");
}

/* PY: высоту и ширину задавать setFixedSize / setMinimumWidth.
   Основное действие: единственная кнопка с полным акцентом. */
ActiveButton {
    background: #0a6ce0;
    border: 1px solid #1a7cf0;
    color: #ffffff;
    font-weight: bold;
}

ActiveButton:hover {
    background: #1a7cf0;
}

ActiveButton:pressed {
    background: #0859bd;
    border: 1px solid #0a6ce0;
}

/* PY: размеры — setMinimumHeight / setMinimumWidth. */
AccentButton {
    background: #15447f;
    border: 1px solid #2a5c98;
    color: #e6eefc;
}

AccentButton:hover {
    background: #1b5394;
    border: 1px solid #3a6fb0;
}

AccentButton:pressed {
    background: #0d2c52;
    border: 1px solid #2a5c98;
}

/* PY: размеры — setMinimumHeight / setMinimumWidth. */
RedButton {
    background: #d11f2e;
    border: 1px solid #e0313f;
    color: #ffffff;
}

RedButton:hover {
    background: #dc2a39;
}

RedButton:pressed {
    background: #e0313f;
    border: 1px solid #f04a57;
}

/* PY: группа «наведение» — выделение через свойство hovered,
   см. HoverGroupBox ниже. */
HoverGroupBox {
    background: #131b23;
    border: 1px solid #33475b;
    border-radius: 8px;
}

HoverGroupBox[hovered="true"] {
    background: #1d2833;
    border: 1px solid #3a4d61;
}

/* PY: размер кнопки-иконки — setFixedSize.
   Радиус и фон оставить здесь. */
USvgWidgetBg {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #ffffff;
}

USvgWidgetBg:hover[style="base"] {
    background: #212c38;
}

USvgWidgetBg[style="selected"] {
    background: #283645;
}

USvgWidgetBg[style="pressed"] {
    background: #3a4d61;
}


/* =====================================================================
   ПОЛЯ ВВОДА
   ===================================================================== */

/* PY: высоту поля — setFixedHeight у QLineEdit.
   padding-right 28px нужен под кнопку очистки. */
ULineEdit {
    background: #1a232d;
    border: 1px solid #2f3f4f;
    border-radius: 6px;
    color: #ffffff;
    padding: 5px 2px 5px 2px;
}

ULineEdit:hover {
    background: #212c38;
    border: 1px solid #3a4d61;
}

/* PY: высоту и отступы — setMinimumHeight и setContentsMargins. */
UTextEdit {
    background: #1a232d;
    border: 1px solid #2f3f4f;
    border-radius: 8px;
    color: #ffffff;
    padding: 5px 2px 5px 2px;
}

UTextEdit:hover {
    background: #212c38;
    border: 1px solid #3a4d61;
}

/* PY: ширину и высоту спинбокса — setFixedWidth / setFixedHeight. */
USpinBox {
    background: #1a232d;
    border: 1px solid #2f3f4f;
    border-radius: 4px;
    color: #ffffff;
}

USpinBox:hover {
    background: #212c38;
    border: 1px solid #3a4d61;
}

/* PY: размеры кнопок — sub-control, остаются в QSS. */
USpinBox::up-button {
    background: transparent;
    border: none;
    color: #ffffff;
    width: 17px;
    height: 9px;
    margin-top: 2px;
    margin-right: 2px;
    border-radius: 3px;
}

USpinBox::up-button:pressed {
    background: #283645;
    border: none;
}

/* PY: размеры кнопок — sub-control, остаются в QSS. */
USpinBox::down-button {
    background: transparent;
    border: none;
    color: #ffffff;
    width: 17px;
    height: 9px;
    margin-bottom: 2px;
    margin-right: 2px;
    border-radius: 3px;
}

USpinBox::down-button:pressed {
    background: #283645;
    border: none;
}

/* PY: размер стрелки — sub-control, остаётся в QSS. */
USpinBox::up-arrow {
    width: 9px;
    height: 9px;
    image: url("./icons/gray/arrow_up.svg");
}

/* PY: размер стрелки — sub-control, остаётся в QSS. */
USpinBox::down-arrow {
    width: 9px;
    height: 9px;
    image: url("./icons/gray/arrow_down.svg");
}

/* PY: размер поля поиска и отступы под иконку лупы оставить здесь. */
SearchWidLineEdit {
    padding-left: 25px;
    padding-right: 25px;
}

/* PY: прозрачное поле в верхней панели — setMinimumHeight. */
BarTopLineEdit {
    background: transparent;
}

BarTopLineEdit:focus {
    background: #1a232d;
}


/* =====================================================================
   ЧЕКБОКСЫ И ОТМЕТКИ
   ===================================================================== */

/* PY: отступ между индикатором и текстом — spacing здесь, размеры в коде не нужны. */
UCheckBox {
    background: transparent;
    border: none;
    color: #ffffff;
    spacing: 6px;
}

/* PY: размер индикатора 15x15 — sub-control, остаётся в QSS. */
UCheckBox::indicator {
    background: transparent;
    border: none;
    width: 15px;
    height: 15px;
    border-radius: 5px;
}

UCheckBox::indicator:checked {
    image: url(./icons/gray/checkmark.svg);
}

UCheckBox::indicator:unchecked {
    image: none;
}

/* PY: размер 16x16 — sub-control. */
UListWidget::indicator {
    background: #1d2833;
    border: 1px solid #3a4d61;
    width: 16px;
    height: 16px;
    border-radius: 4px;
}

UListWidget::indicator:disabled {
    background: #1d2833;
    border: 1px solid #3a4d61;
}

UListWidget::indicator:checked {
    image: url(./icons/gray/checkmark.svg);
}


/* =====================================================================
   МЕНЮ
   ===================================================================== */

/* PY: минимальную ширину меню — setMinimumWidth у QMenu.
   Внутренний padding оставить в QSS, его учитывает сам Qt. */
UMenu {
    background: #131b23;
    border: 1px solid #243240;
    border-radius: 8px;
    color: #ffffff;
    padding: 5px 2px 5px 2px;
}

/* PY: высоту строки лучше задавать через sizeHint, а не padding:
   padding зависит от шрифта. Пока оставить в QSS. */
UMenu::item {
    background: transparent;
    border: none;
    color: #ffffff;
    padding: 5px 30px 5px 10px;
}

UMenu::item:selected {
    background: #1d2833;
    border-radius: 6px;
}

/* PY: отступ иконки — sub-control, остаётся в QSS. */
UMenu::icon {
    padding-left: 5px;
}

/* PY: размер индикатора — sub-control, остаётся в QSS. */
UMenu::indicator {
    width: 16px;
    height: 16px;
    padding-left: 5px;
}

UMenu::indicator:checked {
    image: url(./icons/gray/checkmark.svg);
}

UMenu::indicator:unchecked {
    image: none;
}

/* PY: размер стрелки подменю — sub-control, остаётся в QSS. */
UMenu::right-arrow {
    width: 12px;
    height: 12px;
    padding-right: 5px;
    image: url("./icons/gray/arrow_right.svg");
}

UMenu::right-arrow:selected {
    image: url("./icons/gray/arrow_right.svg");
}


/* =====================================================================
   СПИСКИ
   ===================================================================== */

/* PY: отступы от краёв — setContentsMargins у виджета.
   Высоту строк — setUniformRowHeights(True). */
UListWidget {
    background: #131b23;
    border: 1px solid #243240;
    border-radius: 8px;
    color: #ffffff;
    padding: 10px 2px 10px 2px;
}

/* PY: высоту строки 30px задавать через sizeHint() делегата,
   а не height в QSS. */
UListWidget::item {
    background: transparent;
    border: none;
    color: #ffffff;
    height: 30px;
}

UListWidget::item:selected {
    background: #1d2833;
    border-radius: 6px;
}

UListWidget::item:selected:!active {
    background: #1d2833;
    border-radius: 6px;
}


/* =====================================================================
   ДЕРЕВЬЯ
   ===================================================================== */

/* PY: отступы от краёв — setContentsMargins у виджета. */
UTreeView {
    background: #131b23;
    border: 1px solid #243240;
    border-radius: 8px;
    color: #ffffff;
    padding: 10px 2px 10px 2px;
}

/* PY: высоту строки 30px задавать через sizeHint() делегата. */
UTreeView::item {
    background: transparent;
    border: none;
    color: #ffffff;
    height: 30px;
}

/* PY: иконки ветвей — sub-control, остаются в QSS. */
UTreeView::branch:has-children:closed {
    image: url(./icons/gray/expand.svg);
}

UTreeView::branch:has-children:open {
    image: url(./icons/gray/collapse.svg);
}

/* PY: отступы от краёв — setContentsMargins у виджета.
   MenuLeft наследует UTreeWidget, поэтому стиль берётся отсюда. */
UTreeWidget {
    background: #131b23;
    border: 1px solid #243240;
    border-radius: 8px;
    color: #ffffff;
    padding: 10px 2px 10px 2px;
}

/* PY: высоту строки 30px задавать через sizeHint() делегата. */
UTreeWidget::item {
    background: transparent;
    border: none;
    color: #ffffff;
    height: 30px;
}

/* PY: иконки ветвей — sub-control, остаются в QSS. */
UTreeWidget::branch:has-children:closed {
    image: url(./icons/gray/expand.svg);
}

UTreeWidget::branch:has-children:open {
    image: url(./icons/gray/collapse.svg);
}


/* =====================================================================
   ТЕГИ
   ===================================================================== */

/* PY: высоту тега — setFixedHeight, скругление 12px даёт капсулу. */
TagWidget {
    background: transparent;
    border: none;
    border-radius: 12px;
    color: #ffffff;
}

TagWidget[style="blue"] {
    background: #0a6ce0;
    border: 1px solid #1a7cf0;
}

TagWidget[style="blue"]:hover {
    background: #1a7cf0;
    border: 1px solid #3a8cf5;
}

TagWidget[style="gray"] {
    background: #303b46;
    border: 1px solid #3d4a56;
}

TagWidget[style="gray"]:hover {
    background: #3a4754;
    border: 1px solid #4a5a6a;
}

TagWidget[style="green"] {
    background: #064e3b;
    border: 1px solid #10b981;
}

TagWidget[style="green"]:hover {
    background: #075f48;
    border: 1px solid #34d399;
}

TagWidget[style="yellow"] {
    background: #3a2c12;
    border: 1px solid #6b5420;
}

TagWidget[style="yellow"]:hover {
    background: #4a3816;
    border: 1px solid #8a6d2a;
}

TagWidget[style="red"] {
    background: #7f1d1d;
    border: 1px solid #ef4444;
}

TagWidget[style="red"]:hover {
    background: #952323;
    border: 1px solid #f87171;
}

TagWidget[style="transparent"] {
    border: 1px solid #2f3f4f;
}

TagWidget[style="transparent"]:hover {
    background: #1d2833;
    border: 1px solid #3a4d61;
}


/* =====================================================================
   СЛАЙДЕР
   ===================================================================== */

/* PY: длину слайдера — setMinimumWidth у QSlider.
   Толщина дорожки — sub-control, остаётся в QSS. */
USlider::groove:horizontal {
    background-color: #243240;
    height: 3px;
    border-radius: 1px;
    margin: 0px;
}

/* PY: размер ползунка — sub-control, остаётся в QSS.
   проверить: по расчёту нужно 3.5px */
USlider::handle:horizontal {
    background-color: #8f9ba6;
    height: 10px;
    width: 10px;
    border-radius: 5px;
    margin: -4px 0;
}


/* =====================================================================
   ПОЛОСА ПРОКРУТКИ
   width / height — полный размер области, margin — отступ от краёв.
   Видимая ширина = 14 - 3 - 3 = 8px, скругление = 4px.
   ===================================================================== */

/* PY: не требуется, стилевой базовый блок. */
QScrollBar {
    background: transparent;
    border: none;
}

/* PY: ширину полосы — sub-control, остаётся в QSS. */
QScrollBar:vertical {
    width: 14px;
    margin: 4px 3px 4px 3px;
}

/* PY: высоту полосы — sub-control, остаётся в QSS. */
QScrollBar:horizontal {
    height: 14px;
    margin: 3px 4px 3px 4px;
}

/* PY: минимальную длину ползунка — sub-control, остаётся в QSS. */
QScrollBar::handle:vertical {
    background: #2f3f4f;
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #3a4d61;
}

QScrollBar::handle:vertical:pressed {
    background: #465a70;
}

QScrollBar::handle:horizontal {
    background: #2f3f4f;
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #3a4d61;
}

QScrollBar::handle:horizontal:pressed {
    background: #465a70;
}

QScrollBar::add-page:vertical {
    background: transparent;
}

QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar::add-page:horizontal {
    background: transparent;
}

QScrollBar::sub-page:horizontal {
    background: transparent;
}

QScrollBar::add-line:vertical {
    height: 0px;
    width: 0px;
    border: none;
    background: none;
}

QScrollBar::sub-line:vertical {
    height: 0px;
    width: 0px;
    border: none;
    background: none;
}

QScrollBar::add-line:horizontal {
    height: 0px;
    width: 0px;
    border: none;
    background: none;
}

QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
    border: none;
    background: none;
}


/* =====================================================================
   ТЕКСТОВЫЕ МЕТКИ
   ===================================================================== */

TransparentLabel {
    background: transparent;
}

TransparentLabel[state="regular"] {
    color: #ffffff;
}

TransparentLabel[state="gray"] {
    color: #7b8792;
}

TransparentLabel[text_bold="true"] {
    font-weight: bold;
}

TransparentLabel[text_size="small"] {
    font-size: 11px;
}

TransparentLabel[text_size="big"] {
    font-size: 20px;
}


/* PY: не требуется. */
CalendarDaySelectedText {
    color: #ffffff;
}

/* PY: шрифт 11px у QToolTip задавать через QFont в коде не нужно,
   тултип использует шрифт приложения. Отступ 2px оставить здесь. */
QToolTip {
    background: #1a232d;
    border: 1px solid #2f3f4f;
    color: #ffffff;
    padding: 2px;
}


/* =====================================================================
   ВЫБОР ПУТИ
   ===================================================================== */

ChoosePathWidget[state="warn"] {
    background: #1d1a0f;
    border: 2px dashed #d9a520;
    border-radius: 8px;
}

ChoosePathWidget[state="ok"] {
    background: #0e1f1b;
    border: 2px dashed #10b981;
    border-radius: 8px;
}

/* Наведение на MfPathWidget: фон заметно светлее, рамка та же */
ChoosePathWidget[state="warn"][hovered="true"] {
    background: #3a3216;
    border: 2px dashed #d9a520;
}

ChoosePathWidget[state="ok"][hovered="true"] {
    background: #1d4234;
    border: 2px dashed #10b981;
}

ChoosePathStatus[state="warn"] {
    color: #e5b93a;
    font-weight: bold;
    font-size: 14px;
}

ChoosePathStatus[state="ok"] {
    color: #34d399;
    font-weight: bold;
    font-size: 14px;
}


/* =====================================================================
   ЗАГОЛОВКИ СТРАНИЦ
   ===================================================================== */

/* PY: размер шрифта — QFont в коде.
   В коде ещё нет класса WinSettingsMfAliasTitle в этом файле, проверить grep. */
WinSettingsMfAliasTitle {
    color: #ffffff;
    font-size: 23px;
    font-weight: bold;
}

/* PY: отступ 1px — setContentsMargins, если нужен. */
ServerLabel {
    padding-left: 1px;
}


/* =====================================================================
   КАЛЕНДАРЬ
   ===================================================================== */

/* PY: размер шрифта 25pt — QFont в коде. */
CalendarBigDate {
    color: #b2b2b2;
    font-size: 25pt;
}
