/* =====================================================================
   ТЁМНАЯ ТЕМА

   Каждый виджет описан отдельным блоком: цвета и геометрия вместе.
   Перед блоком комментарий PY: что из геометрии стоит вынести в код
   и как это сделать. Пока геометрия остаётся в QSS.

   Палитра (по ролям):
     Фоны
       #000000                  просмотр изображений, превью поиска
       #0c1218                  UFrame
       #101820                  панели: GroupBox, списки, деревья, меню
       #111a23                  зона перетаскивания
       #18212a                  кнопки, поля, спинбокс, разделитель,
                                тултип, карточка миниатюры
       rgba(40, 54, 69, 191)    кнопка «вверх»
       rgba(0, 0, 0, 150)       затемнение окна
     Рамки
       #1d2b38                  рамка UFrame
       #263440                  рамка панелей и полей, дорожка слайдера,
                                полоса прокрутки
     Состояния
       #1d2833                  наведение, выделение, отметка в списке
       #202c38                  нажатая стрелка спинбокса
       #283645                  иконочная кнопка: выбрано
       #30404f                  рамка при наведении, чекбокс, полоса
                                прокрутки при наведении
       #3a4b5e                  иконочная кнопка и полоса прокрутки: нажатие
     Текст
       #ffffff                  основной текст
       #7b8792                  серый текст подписей
     Акцент
       #0059d1                  ActiveButton, синий тег, рамка миниатюры
       #0a63dc                  ActiveButton: наведение
       #0e69df / #2d7be1        ActiveButton: нажатие (фон / рамка)
     Теги
       #303b46 / #3d4a56        серый
       #064e3b / #10b981        зелёный
       #3a2c12 / #6b5420        жёлтый
       #7f1d1d / #ef4444        красный
     Слайдер
       #8f9ba6                  ползунок

   ВАЖНО: цвет выделения списков (#1d2833) дублируется в system/themes.py,
   класс DarkTreeTheme.sel_color. При смене цвета меняйте в обоих местах.
   Выделение дерева (UTreeView, UTreeWidget) рисует делегат, в QSS его нет.
   ===================================================================== */


/* =====================================================================
   ПРОЗРАЧНЫЕ ОБЁРТКИ
   ===================================================================== */

/* PY: не требуется, чисто стилевая обёртка. */
TransparentButton {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
TransparentFrame {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
TransparentWidget {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
TransparentLineEdit {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
TransparentTextEdit {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
TransparentMenu {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
TransparentScrollArea {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
/* проверить: grep по коду, используется ли класс */
MacControlButton {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* PY: не требуется. */
ImgViewSvg {
    background: transparent;
    border: none;
    color: #ffffff;
}


/* =====================================================================
   ФРЕЙМЫ И ПАНЕЛИ
   ===================================================================== */

/* PY: внутренние отступы в layout — setContentsMargins.
   Размер рамки и скругление можно оставить здесь. */
UFrame {
    background: #ff0c1218;
    border: 1px solid #ff1d2b38;
    border-radius: 8px;
    color: #ffffff;
}

/* PY: размер просмотрщика задавать через setMinimumSize в коде,
   рамка прозрачна, чтобы не было сдвига при изменении. */
UBlackFrame {
    background: #000000;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #ffffff;
}

/* PY: отступы содержимого группы — setContentsMargins у layout. */
UGroupBox {
    background: #101820;
    border: 1px solid #263440;
    border-radius: 8px;
    color: #ffffff;
}

/* PY: высоту разделителя задать setFixedHeight(1).
   Цвета и рамка остаются в QSS. */
USep {
    background: #18212a;
    border: 1px solid #263440;
    color: #ffffff;
}

/* PY: размер миниатюры — setFixedSize в коде.
   Рамка остаётся в QSS, потому что меняется при выделении. */
Thumb {
    border: 2px solid transparent;
    border-radius: 8px;
}

/* PY: то же, что и у Thumb. */
SquareThumb {
    border: 2px solid transparent;
    border-radius: 8px;
}

/* PY: размер плитки — setFixedSize, отступы — setContentsMargins. */
ThumbImgWidget {
    background: #18212a;
    border-radius: 6px;
}

/* PY: размер шрифта 11px — QFont в коде. */
ThumbFilenameWid {
    font-size: 11px;
}

/* PY: размер шрифта 11px — QFont в коде. */
ThumbBlueTextWidget {
    font-size: 11px;
}

/* PY: размер шрифта 11px — QFont в коде. */
ThumbMiuzBlueTextWidget {
    font-size: 11px;
}

/* PY: размер шрифта 20px и жирность — QFont в коде. */
_TitleTextLabel {
    font-weight: bold;
    font-size: 20px;
}

/* PY: размер шрифта 15px — QFont в коде. */
/* проверить: grep по коду, используется ли класс */
MfPathTitle {
    font-size: 15px;
}

/* Чёрные области: просмотр изображений, превью поиска */

/* PY: размер области — setMinimumSize, радиус оставить здесь. */
WinImgViewGraphics {
    background: #000000;
    border-radius: 8px;
}

/* PY: размер области — setMinimumSize, радиус оставить здесь. */
WinImageView {
    background: #000000;
    border-radius: 8px;
}

/* PY: размер области — setMinimumSize, радиус оставить здесь. */
WinImgSearchPreviewWidget {
    background: #000000;
    border-radius: 8px;
}

/* PY: размер и пунктирная рамка оставить здесь,
   отступы внутри — setContentsMargins у layout. */
WinImgSearchDropWidget {
    background: #111a23;
    border: 2px dashed #263440;
    border-radius: 8px;
}

/* PY: размер кнопки «вверх» — setFixedSize (например 36x36),
   радиус 18px даёт круг. */
UpBtnLabel {
    background: rgba(40, 54, 69, 191);
    border: none;
    border-radius: 18px;
    color: #ffffff;
}

/* PY: затемнение на всё окно — setGeometry по размеру родителя в коде. */
UMainWinOverlay {
    background: rgba(0, 0, 0, 150);
    border-radius: 8px;
}

/* PY: отступ от края — setContentsMargins родительского layout,
   margin здесь не даёт ожидаемого результата внутри layout. */
MenuLeft {
    background: #171717;
    border: 1px solid #2d2d2d;
    border-radius: 8px;
    margin: 5px;
}


/* =====================================================================
   КНОПКИ
   ===================================================================== */

/* PY: минимальные размеры — setMinimumHeight / setMinimumWidth.
   Отступы текста оставить здесь. */
UPushButton {
    background: #18212a;
    border: 1px solid #263440;
    border-radius: 8px;
    color: #ffffff;
    font-size: 11px;
    padding-left: 5px;
    padding-right: 5px;
}

UPushButton:hover {
    background: #1d2833;
    border: 1px solid #30404f;
}

UPushButton:pressed {
    border: 1px solid #30404f;
}

/* PY: размер стрелки меню — sub-control, остаётся в QSS. */
UPushButton::menu-indicator {
    width: 12px;
    height: 12px;
    image: url("./icons/gray/arrow_down.svg");
}

/* PY: высоту и ширину задавать setFixedSize / setMinimumWidth. */
ActiveButton {
    background: #0059d1;
    border: 1px solid #0e69df;
    color: #ffffff;
}

ActiveButton:hover {
    background: #0a63dc;
}

ActiveButton:pressed {
    background: #0e69df;
    border: 1px solid #2d7be1;
}

/* PY: размеры — setMinimumHeight / setMinimumWidth. */
AccentButton {
    background: #15447f;
    border: 1px solid #2a5c98;
    color: #e6eefc;
}

AccentButton:hover {
    background: #1b5394;
    border: 1px solid #3a6fb0;
}

AccentButton:pressed {
    background: #0d2c52;
    border: 1px solid #2a5c98;
}

/* PY: размеры — setMinimumHeight / setMinimumWidth. */
RedButton {
    background: #d11f2e;
    border: 1px solid #e0313f;
    color: #ffffff;
}

RedButton:hover {
    background: #dc2a39;
}

RedButton:pressed {
    background: #e0313f;
    border: 1px solid #f04a57;
}

/* PY: группа «наведение» — выделение через свойство hovered,
   см. HoverGroupBox ниже. */
HoverGroupBox {
    background: #101820;
    border: 1px solid #263440;
    border-radius: 8px;
}

HoverGroupBox[hovered="true"] {
    background: #1d2833;
    border: 1px solid #30404f;
}

/* PY: размер кнопки-иконки — setFixedSize.
   Радиус и фон оставить здесь. */
USvgWidgetBg {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #ffffff;
}

USvgWidgetBg:hover[style="base"] {
    background: #1d2833;
}

USvgWidgetBg[style="selected"] {
    background: #283645;
}

USvgWidgetBg[style="pressed"] {
    background: #3a4b5e;
}


/* =====================================================================
   ПОЛЯ ВВОДА
   ===================================================================== */

/* PY: высоту поля — setFixedHeight у QLineEdit.
   padding-right 28px нужен под кнопку очистки. */
ULineEdit {
    background: #18212a;
    border: 1px solid #263440;
    border-radius: 6px;
    color: #ffffff;
    padding: 5px 2px 5px 2px;
}

ULineEdit:hover {
    background: #1d2833;
    border: 1px solid #30404f;
}

/* PY: высоту и отступы — setMinimumHeight и setContentsMargins. */
UTextEdit {
    background: #18212a;
    border: 1px solid #263440;
    border-radius: 8px;
    color: #ffffff;
    padding: 5px 2px 5px 2px;
}

UTextEdit:hover {
    background: #1d2833;
    border: 1px solid #30404f;
}

/* PY: ширину и высоту спинбокса — setFixedWidth / setFixedHeight. */
USpinBox {
    background: #18212a;
    border: 1px solid #263440;
    border-radius: 4px;
    color: #ffffff;
}

USpinBox:hover {
    background: #1d2833;
    border: 1px solid #30404f;
}

/* PY: размеры кнопок — sub-control, остаются в QSS. */
USpinBox::up-button {
    background: transparent;
    border: none;
    color: #ffffff;
    width: 17px;
    height: 9px;
    margin-top: 2px;
    margin-right: 2px;
    border-radius: 3px;
}

USpinBox::up-button:pressed {
    background: #202c38;
    border: none;
}

/* PY: размеры кнопок — sub-control, остаются в QSS. */
USpinBox::down-button {
    background: transparent;
    border: none;
    color: #ffffff;
    width: 17px;
    height: 9px;
    margin-bottom: 2px;
    margin-right: 2px;
    border-radius: 3px;
}

USpinBox::down-button:pressed {
    background: #202c38;
    border: none;
}

/* PY: размер стрелки — sub-control, остаётся в QSS. */
USpinBox::up-arrow {
    width: 9px;
    height: 9px;
    image: url("./icons/gray/arrow_up.svg");
}

/* PY: размер стрелки — sub-control, остаётся в QSS. */
USpinBox::down-arrow {
    width: 9px;
    height: 9px;
    image: url("./icons/gray/arrow_down.svg");
}

/* PY: размер поля поиска и отступы под иконку лупы оставить здесь. */
SearchWidLineEdit {
    padding-left: 25px;
    padding-right: 25px;
}

/* PY: прозрачное поле в верхней панели — setMinimumHeight. */
BarTopLineEdit {
    background: transparent;
}

BarTopLineEdit:focus {
    background: #2b2b2b;
}


/* =====================================================================
   ЧЕКБОКСЫ И ОТМЕТКИ
   ===================================================================== */

/* PY: отступ между индикатором и текстом — spacing здесь, размеры в коде не нужны. */
UCheckBox {
    background: transparent;
    border: none;
    color: #ffffff;
    spacing: 6px;
}

/* PY: размер индикатора 15x15 — sub-control, остаётся в QSS. */
UCheckBox::indicator {
    background: transparent;
    border: none;
    width: 15px;
    height: 15px;
    border-radius: 5px;
}

UCheckBox::indicator:checked {
    image: url(./icons/gray/checkmark.svg);
}

UCheckBox::indicator:unchecked {
    image: none;
}

/* PY: размер 16x16 — sub-control. */
UListWidget::indicator {
    background: #1d2833;
    border: 1px solid #30404f;
    width: 16px;
    height: 16px;
    border-radius: 4px;
}

UListWidget::indicator:disabled {
    background: #1d2833;
    border: 1px solid #30404f;
}

UListWidget::indicator:checked {
    image: url(./icons/gray/checkmark.svg);
}


/* =====================================================================
   МЕНЮ
   ===================================================================== */

/* PY: минимальную ширину меню — setMinimumWidth у QMenu.
   Внутренний padding оставить в QSS, его учитывает сам Qt. */
UMenu {
    background: #101820;
    border: 1px solid #263440;
    border-radius: 8px;
    color: #ffffff;
    padding: 5px 2px 5px 2px;
}

/* PY: высоту строки лучше задавать через sizeHint, а не padding:
   padding зависит от шрифта. Пока оставить в QSS. */
UMenu::item {
    background: transparent;
    border: none;
    color: #ffffff;
    padding: 5px 30px 5px 10px;
}

UMenu::item:selected {
    background: #1d2833;
    border-radius: 6px;
}

/* PY: отступ иконки — sub-control, остаётся в QSS. */
UMenu::icon {
    padding-left: 5px;
}

/* PY: размер индикатора — sub-control, остаётся в QSS. */
UMenu::indicator {
    width: 16px;
    height: 16px;
    padding-left: 5px;
}

UMenu::indicator:checked {
    image: url(./icons/gray/checkmark.svg);
}

UMenu::indicator:unchecked {
    image: none;
}

/* PY: размер стрелки подменю — sub-control, остаётся в QSS. */
UMenu::right-arrow {
    width: 12px;
    height: 12px;
    padding-right: 5px;
    image: url("./icons/gray/arrow_right.svg");
}

UMenu::right-arrow:selected {
    image: url("./icons/gray/arrow_right.svg");
}


/* =====================================================================
   СПИСКИ
   ===================================================================== */

/* PY: отступы от краёв — setContentsMargins у виджета.
   Высоту строк — setUniformRowHeights(True). */
UListWidget {
    background: #101820;
    border: 1px solid #263440;
    border-radius: 8px;
    color: #ffffff;
    padding: 10px 2px 10px 2px;
}

/* PY: высоту строки 30px задавать через sizeHint() делегата,
   а не height в QSS. */
UListWidget::item {
    background: transparent;
    border: none;
    color: #ffffff;
    height: 30px;
}

UListWidget::item:selected {
    background: #1d2833;
    border-radius: 6px;
}

UListWidget::item:selected:!active {
    background: #1d2833;
    border-radius: 6px;
}


/* =====================================================================
   ДЕРЕВЬЯ
   ===================================================================== */

/* PY: отступы от краёв — setContentsMargins у виджета. */
UTreeView {
    background: #101820;
    border: 1px solid #263440;
    border-radius: 8px;
    color: #ffffff;
    padding: 10px 2px 10px 2px;
}

/* PY: высоту строки 30px задавать через sizeHint() делегата. */
UTreeView::item {
    background: transparent;
    border: none;
    color: #ffffff;
    height: 30px;
}

/* PY: иконки ветвей — sub-control, остаются в QSS. */
UTreeView::branch:has-children:closed {
    image: url(./icons/gray/expand.svg);
}

UTreeView::branch:has-children:open {
    image: url(./icons/gray/collapse.svg);
}

/* PY: отступы от краёв — setContentsMargins у виджета. */
UTreeWidget {
    background: #101820;
    border: 1px solid #263440;
    border-radius: 8px;
    color: #ffffff;
    padding: 10px 2px 10px 2px;
}

/* PY: высоту строки 30px задавать через sizeHint() делегата. */
UTreeWidget::item {
    background: transparent;
    border: none;
    color: #ffffff;
    height: 30px;
}

/* PY: иконки ветвей — sub-control, остаются в QSS. */
UTreeWidget::branch:has-children:closed {
    image: url(./icons/gray/expand.svg);
}

UTreeWidget::branch:has-children:open {
    image: url(./icons/gray/collapse.svg);
}


/* =====================================================================
   ТЕГИ
   ===================================================================== */

/* PY: высоту тега — setFixedHeight, скругление 12px даёт капсулу. */
TagWidget {
    background: transparent;
    border: none;
    border-radius: 12px;
    color: #ffffff;
}

TagWidget[style="blue"] {
    background: #0059d1;
    border: 1px solid #156ee3;
}

TagWidget[style="gray"] {
    background: #303b46;
    border: 1px solid #3d4a56;
}

TagWidget[style="green"] {
    background: #064e3b;
    border: 1px solid #10b981;
}

TagWidget[style="yellow"] {
    background: #3a2c12;
    border: 1px solid #6b5420;
}

TagWidget[style="red"] {
    background: #7f1d1d;
    border: 1px solid #ef4444;
}

TagWidget[style="transparent"] {
    border: 1px solid #30404f;
}


/* =====================================================================
   СЛАЙДЕР
   ===================================================================== */

/* PY: длину слайдера — setMinimumWidth у QSlider.
   Толщина дорожки — sub-control, остаётся в QSS. */
USlider::groove:horizontal {
    background-color: #263440;
    height: 3px;
    border-radius: 1px;
    margin: 0px;
}

/* PY: размер ползунка — sub-control, остаётся в QSS.
   /* проверить: по расчёту нужно 3.5px */
USlider::handle:horizontal {
    background-color: #8f9ba6;
    height: 10px;
    width: 10px;
    border-radius: 5px;
    margin: -4px 0;
}


/* =====================================================================
   ПОЛОСА ПРОКРУТКИ
   width / height — полный размер области, margin — отступ от краёв.
   Видимая ширина = 14 - 3 - 3 = 8px, скругление = 4px.
   ===================================================================== */

/* PY: не требуется, стилевой базовый блок. */
QScrollBar {
    background: transparent;
    border: none;
}

/* PY: ширину полосы — sub-control, остаётся в QSS. */
QScrollBar:vertical {
    width: 14px;
    margin: 4px 3px 4px 3px;
}

/* PY: высоту полосы — sub-control, остаётся в QSS. */
QScrollBar:horizontal {
    height: 14px;
    margin: 3px 4px 3px 4px;
}

/* PY: минимальную длину ползунка — sub-control, остаётся в QSS. */
QScrollBar::handle:vertical {
    background: #263440;
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #30404f;
}

QScrollBar::handle:vertical:pressed {
    background: #3a4b5e;
}

QScrollBar::handle:horizontal {
    background: #263440;
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #30404f;
}

QScrollBar::handle:horizontal:pressed {
    background: #3a4b5e;
}

QScrollBar::add-page:vertical {
    background: transparent;
}

QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar::add-page:horizontal {
    background: transparent;
}

QScrollBar::sub-page:horizontal {
    background: transparent;
}

QScrollBar::add-line:vertical {
    height: 0px;
    width: 0px;
    border: none;
    background: none;
}

QScrollBar::sub-line:vertical {
    height: 0px;
    width: 0px;
    border: none;
    background: none;
}

QScrollBar::add-line:horizontal {
    height: 0px;
    width: 0px;
    border: none;
    background: none;
}

QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
    border: none;
    background: none;
}


/* =====================================================================
   ТЕКСТОВЫЕ МЕТКИ
   ===================================================================== */

/* PY: не требуется, чисто стиль. */
TransparentLabel {
    background: transparent;
    border: none;
    color: #ffffff;
}

TransparentLabel[state="regular"] {
    color: #ffffff;
}

TransparentLabel[state="gray"] {
    color: #7b8792;
}

TransparentLabel[state="regular_bold"] {
    color: #ffffff;
    font-weight: bold;
}

TransparentLabel[state="gray_bold"] {
    color: #7b8792;
    font-weight: bold;
}

/* PY: размер шрифта 14px — QFont в коде. */
ChoosePathWidget TransparentLabel {
    font-weight: bold;
    font-size: 14px;
    color: #ffffff;
}

/* PY: не требуется. */
CalendarDaySelectedText {
    color: #ffffff;
}

/* PY: шрифт 11px у QToolTip задавать через QFont в коде не нужно,
   тултип использует шрифт приложения. Отступ 2px оставить здесь. */
QToolTip {
    background: #18212a;
    border: 1px solid #263440;
    color: #ffffff;
    padding: 2px;
}


/* =====================================================================
   ВЫБОР ПУТИ
   ===================================================================== */

/* PY: размер области — setMinimumSize. Отступы — setContentsMargins. */
ChoosePathWidget {
    border-radius: 9px;
    padding: 2px 2px;
}

ChoosePathWidget[state="ok"] {
    background: #27064e3b;
    border: 2px dashed #10b981;
}

ChoosePathWidget[state="warn"] {
    background: #273a2c12;
    border: 2px dashed #6b5420;
}


/* =====================================================================
   ЗАГОЛОВКИ СТРАНИЦ
   ===================================================================== */

/* PY: размер шрифта — QFont в коде.
   В коде ещё нет класса WinSettingsMfAliasTitle в этом файле, проверить grep. */
WinSettingsMfAliasTitle {
    color: #ffffff;
    font-size: 23px;
    font-weight: bold;
}

/* PY: размер шрифта 11pt — QFont в коде. */
WinInfoLeftLabel {
    font-size: 11pt;
}

/* PY: размер шрифта 11pt — QFont в коде. */
WinInfoSelectableLabel {
    font-size: 11pt;
}

/* PY: отступ 1px — setContentsMargins, если нужен. */
ServerLabel {
    padding-left: 1px;
}


/* =====================================================================
   КАЛЕНДАРЬ
   ===================================================================== */

/* PY: размер шрифта 25pt — QFont в коде. */
CalendarBigDate {
    color: #b2b2b2;
    font-size: 25pt;
}