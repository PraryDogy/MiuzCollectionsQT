/* win_filters.py */

WinFiltersTagWidget {
    border-radius: 10px;
    color: #ffffff;
}

WinFiltersTagWidget[active="True"] {
    background: #0059D1;;
    border: 1px solid #156ee3;
}


WinFiltersTagWidget[active="False"] {
    background: #4e4e4e;
    border: 1px solid #585858;
}


WinFiltersAddTag[active="False"] {
    border-radius: 10px;
    color: #ffffff;
    background: transparent;
    border: 1px solid #585858;
}

