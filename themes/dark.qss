/* =====================================================================
   ТЁМНАЯ ТЕМА (основная)

   Структура файла (светлая тема устроена так же):
   1. Прозрачная основа
   2. Цвета по группам: фоны, рамки, состояния, текст, акценты, теги,
      прокрутка, особые кнопки
   3. Геометрия: скругления, отступы, размеры, иконки

   Правило: при одинаковой специфичности побеждает правило, написанное
   позже. Основа идёт первой, цвета перекрывают её.

   Палитра (по ролям):
     Фоны
       #000000                  просмотр изображений, превью поиска
       #0c1218                  UFrame
       #101820                  панели: GroupBox, списки, деревья, меню
       #111a23                  зона перетаскивания
       #18212a                  кнопки, поля, спинбокс, разделитель,
                                тултип, карточка миниатюры
       rgba(40, 54, 69, 191)    кнопка «вверх»
       rgba(0, 0, 0, 150)       затемнение окна
     Рамки
       #1d2b38                  рамка UFrame
       #263440                  рамка панелей и полей, дорожка слайдера,
                                полоса прокрутки
     Состояния
       #1d2833                  наведение, выделение, отметка в списке
       #202c38                  нажатая стрелка спинбокса
       #283645                  иконочная кнопка: выбрано
       #30404f                  рамка при наведении, чекбокс, полоса
                                прокрутки при наведении
       #3a4b5e                  иконочная кнопка и полоса прокрутки: нажатие
     Текст
       #ffffff                  основной текст
       #7b8792                  серый текст подписей
     Акцент
       #0059d1                  ActiveButton, синий тег, рамка миниатюры
       #0a63dc                  ActiveButton: наведение
       #0e69df / #2d7be1        ActiveButton: нажатие (фон / рамка)
       #156ee3                  рамка синего тега
     Теги
       #303b46 / #3d4a56        серый
       #064e3b / #10b981        зелёный
       #713f12 / #eab308        жёлтый
       #7f1d1d / #ef4444        красный
     Слайдер
       #8f9ba6                  ползунок
     Красная кнопка
       #ff646d / #b8414c        текст / рамка
       #2b2027 / #e0525b        наведение (фон / рамка)
       #40232a                  нажатие

   ВАЖНО: при смене цвета UListWidget::item:selected или UMenu::item:selected
   поменяйте sel_color в system/themes.py (класс DarkTreeTheme).
   Выделение дерева (UTreeView, UTreeWidget) рисует делегат, здесь его нет.
   ===================================================================== */


/* =====================================================================
   1. ПРОЗРАЧНАЯ ОСНОВА
   Все виджеты стартуют прозрачными и без рамки.
   ===================================================================== */

TransparentButton,
TransparentLabel,
TransparentFrame,
TransparentWidget,
TransparentLineEdit,
TransparentTextEdit,
TransparentMenu,
TransparentScrollArea,
MacControlButton,                /* проверить: grep по коду */
UFrame,
UBlackFrame,
UGroupBox,
UTreeView,
UListWidget,
UTreeWidget,
UMenu,
UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
USpinBox::up-button,
USpinBox::down-button,
USep,
UCheckBox,
UCheckBox::indicator,
UTagWidget,
UpBtnLabel,
ImgViewSvg,
_SvgWithThemeBg {
    background: transparent;
    border: none;
    color: #ffffff;
}

/* Рамка миниатюры всегда есть, но прозрачна:
   при выделении меняется только цвет, размер не сдвигается. */
Thumb,
SquareThumb {
    border: 2px solid transparent;
}

UTreeView::item,
UListWidget::item,
UTreeWidget::item,
UMenu::item {
    background: transparent;
    border: none;
}


/* =====================================================================
   2. ЦВЕТА
   ===================================================================== */

/* ---------------------------------------------------------------------
   2.1 ФОНЫ
   --------------------------------------------------------------------- */

/* Чёрные области: просмотр изображений, превью поиска */
UBlackFrame,
WinImgViewGraphics,
WinImageView,
WinImgSearchPreviewWidget {
    background: #000000;
}

/* Формат #AARRGGBB: ff в начале — полная непрозрачность */
UFrame {
    background: #ff0c1218;
}

UGroupBox,
UListWidget,
UTreeView,
UTreeWidget,
UMenu {
    background: #101820;
}

WinImgSearchDropWidget {
    background: #111a23;
}

UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
USep,
QToolTip,
ThumbImgWidget {
    background: #18212a;
}

UpBtnLabel {
    background: rgba(40, 54, 69, 191);
}

/* Затемнение окна, когда поверх открыто другое UMainWindow */
UMainWinOverlay {
    background: rgba(0, 0, 0, 150);
}


/* ---------------------------------------------------------------------
   2.2 РАМКИ
   --------------------------------------------------------------------- */

UBlackFrame {
    border: 1px solid transparent;
}

UFrame {
    border: 1px solid #ff1d2b38;
}

UGroupBox,
UListWidget,
UTreeView,
UTreeWidget,
UMenu,
UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
USep,
QToolTip {
    border: 1px solid #263440;
}

WinImgSearchDropWidget {
    border: 2px dashed #263440;
}


/* ---------------------------------------------------------------------
   2.3 СОСТОЯНИЯ: наведение, выделение, нажатие
   --------------------------------------------------------------------- */

/* Наведение на поля, кнопки, спинбокс */
UPushButton:hover,
ULineEdit:hover,
UTextEdit:hover,
USpinBox:hover {
    background: #1d2833;
    border: 1px solid #30404f;
}

_SvgWithThemeBg:hover[style="base"] {
    background: #1d2833;
}

/* Отметка в списке */
UListWidget::indicator,
UListWidget::indicator:disabled {
    background: #1d2833;
    border: 1px solid #30404f;
}

/* Выделение пунктов списков и меню */
UListWidget::item:selected,
UListWidget::item:selected:!active,
UMenu::item:selected {
    background: #1d2833;
}

/* Нажатие */
UPushButton:pressed {
    border: 1px solid #30404f;
}

USpinBox::up-button:pressed,
USpinBox::down-button:pressed {
    background: #202c38;
    border: none;
}

/* Иконочные кнопки */
_SvgWithThemeBg[style="selected"] {
    background: #283645;
}

_SvgWithThemeBg[style="pressed"] {
    background: #3a4b5e;
}

/* Выбранная миниатюра: меняется только цвет рамки, размер не меняется */
Thumb[framed="true"],
SquareThumb[framed="true"] {
    border: 2px solid #0059d1;
}


/* ---------------------------------------------------------------------
   2.4 ПОЛОСА ПРОКРУТКИ
   Фон дорожки прозрачный, ползунок: обычный / наведение / нажатие.
   --------------------------------------------------------------------- */

QScrollBar {
    background: transparent;
    border: none;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #263440;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #30404f;
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background: #3a4b5e;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}


/* ---------------------------------------------------------------------
   2.5 ТЕКСТ
   --------------------------------------------------------------------- */

UPushButton,
ULineEdit,
UTextEdit,
USpinBox,
QToolTip,
UTreeView::item,
UListWidget::item,
UTreeWidget::item,
UMenu::item,
UTagWidget {
    color: #ffffff;
}

GrayTextLabel {
    color: #7b8792;
}

CalendarDaySelectedText {
    color: #ffffff;
}


/* ---------------------------------------------------------------------
   2.6 АКЦЕНТ: основная кнопка
   --------------------------------------------------------------------- */

ActiveButton {
    background: #0059d1;
    border: 1px solid #0e69df;
    color: #ffffff;
}

ActiveButton:hover {
    background: #0a63dc;
}

ActiveButton:pressed {
    background: #0e69df;
    border: 1px solid #2d7be1;
}


/* ---------------------------------------------------------------------
   2.7 ТЕГИ
   --------------------------------------------------------------------- */

UTagWidget[style="blue"] {
    background: #0059d1;
    border: 1px solid #156ee3;
}

UTagWidget[style="gray"] {
    background: #303b46;
    border: 1px solid #3d4a56;
}

UTagWidget[style="green"] {
    background: #064e3b;
    border: 1px solid #10b981;
}

UTagWidget[style="yellow"] {
    background: #713f12;
    border: 1px solid #eab308;
}

UTagWidget[style="red"] {
    background: #7f1d1d;
    border: 1px solid #ef4444;
}

UTagWidget[style="transparent"] {
    border: 1px solid #30404f;
}


/* ---------------------------------------------------------------------
   2.8 СЛАЙДЕР
   --------------------------------------------------------------------- */

USlider::groove:horizontal {
    background-color: #263440;
}

USlider::handle:horizontal {
    background-color: #8f9ba6;
}


/* ---------------------------------------------------------------------
   2.9 ОСОБЫЕ КНОПКИ
   --------------------------------------------------------------------- */

RedButton {
    color: #FF646D;
    background: transparent;
    border: 1px solid #B8414C;
}

RedButton:hover {
    background: #2B2027;
    border: 1px solid #E0525B;
}

RedButton:pressed {
    background: #40232A;
    border: 1px solid #FF646D;
}


/* =====================================================================
   3. ГЕОМЕТРИЯ (без цветов)
   ===================================================================== */

/* --- Скругления --- */
UFrame,
UBlackFrame,
UGroupBox,
UListWidget,
UTreeView,
UTreeWidget,
UMenu,
UTextEdit,
WinImgViewGraphics,
WinImageView,
WinImgSearchPreviewWidget,
Thumb,
SquareThumb,
UMainWinOverlay {
    border-radius: 8px;
}

ThumbImgWidget {
    border-radius: 6px;
}

UTagWidget {
    border-radius: 12px;
}

WinImgSearchDropWidget {
    border-radius: 20px;
}

UpBtnLabel {
    border-radius: 18px;
}

UPushButton,
_SvgWithThemeBg {
    border-radius: 8px;
}

ULineEdit {
    border-radius: 6px;
}

USpinBox {
    border-radius: 4px;
}

USpinBox::up-button,
USpinBox::down-button {
    border-radius: 3px;
}

UCheckBox::indicator {
    border-radius: 5px;
}

UListWidget::indicator {
    border-radius: 4px;
}

USlider::groove:horizontal {
    border-radius: 1px;
}

USlider::handle:horizontal {
    border-radius: 5px;
}

/* Значение совпадает с sel_radius в system/themes.py (DarkTreeTheme) */
UListWidget::item:selected,
UListWidget::item:selected:!active,
UMenu::item:selected {
    border-radius: 6px;
}


/* --- Отступы и размеры --- */
UTreeView,
UListWidget,
UTreeWidget {
    padding: 10px 2px 10px 2px;
}

UTreeView::item,
UListWidget::item,
UTreeWidget::item {
    height: 30px;
}

UMenu {
    padding: 5px 2px 5px 2px;
}

UMenu::item {
    padding: 5px 30px 5px 10px;
}

UMenu::icon {
    padding-left: 5px;
}

UMenu::indicator {
    width: 16px;
    height: 16px;
    padding-left: 5px;
}

UMenu::right-arrow {
    width: 12px;
    height: 12px;
    padding-right: 5px;
}

ULineEdit,
UTextEdit {
    padding: 5px 2px 5px 2px;
}

UPushButton {
    font-size: 11px;
    padding-left: 5px;
    padding-right: 5px;
}

UPushButton::menu-indicator {
    width: 12px;
    height: 12px;
}

USpinBox::up-button,
USpinBox::down-button {
    width: 17px;
    margin-right: 2px;
}

USpinBox::up-button {
    height: 9px;
    margin-top: 2px;
}

USpinBox::down-button {
    height: 9px;
    margin-bottom: 2px;
}

USpinBox::up-arrow,
USpinBox::down-arrow {
    width: 9px;
    height: 9px;
}

UCheckBox {
    spacing: 6px;
}

UCheckBox::indicator {
    width: 15px;
    height: 15px;
}

UListWidget::indicator {
    width: 16px;
    height: 16px;
}

USlider::groove:horizontal {
    height: 3px;
    margin: 0px;
}

USlider::handle:horizontal {
    height: 10px;
    width: 10px;
    margin: -4px 0;   /* проверить: по расчёту нужно 3.5px */
}

SearchWidLineEdit {
    padding-left: 25px;
    padding-right: 25px;
}

QToolTip {
    padding: 2px;
}

TitleTextLabel TransparentLabel {
    font-weight: bold;
    font-size: 20px;
}

MfPathTitle {                    /* проверить: grep по коду */
    font-size: 15px;
}

ThumbFilenameWid,
ThumbBlueTextWidget,
ThumbMiuzBlueTextWidget {
    font-size: 11px;
}


/* --- Полоса прокрутки ---
   width / height — полный размер области, margin — отступ от краёв.
   Видимая ширина = 14 - 3 - 3 = 8px, скругление = 4px. */
QScrollBar:vertical {
    width: 14px;
    margin: 4px 3px 4px 3px;
}

QScrollBar:horizontal {
    height: 14px;
    margin: 3px 4px 3px 4px;
}

QScrollBar::handle:vertical {
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
    border: none;
    background: none;
}


/* --- Иконки --- */
UMenu::indicator:checked,
UListWidget::indicator:checked,
UCheckBox::indicator:checked {
    image: url(./icons/common/checkmark_small.svg);
}

UMenu::indicator:unchecked,
UCheckBox::indicator:unchecked {
    image: none;
}

UMenu::right-arrow,
UMenu::right-arrow:selected {
    image: url("./icons/common/arrow_right.svg");
}

UPushButton::menu-indicator {
    image: url("./icons/common/arrow_down.svg");
}

USpinBox::up-arrow {
    image: url("./icons/common/arrow_up.svg");
}

USpinBox::down-arrow {
    image: url("./icons/common/arrow_down.svg");
}

UTreeView::branch:has-children:closed,
UTreeWidget::branch:has-children:closed {
    image: url(./icons/common/expand_r.svg);
}

UTreeView::branch:has-children:open,
UTreeWidget::branch:has-children:open {
    image: url(./icons/common/collapse_r.svg);
}