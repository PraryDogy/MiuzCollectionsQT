/* grid.py */
ThumbImgWidget {
    border-radius: 10px;
}

ThumbImgWidget[framed="false"] {
    background: transparent;
}

ThumbImgWidget[framed="true"] {
    background: #363636;
}

ThumbWhiteTextWid {
    padding: 2px;
    border-radius: 5px;
    font-size: 11px;
    color: #FFFFFF;
}

ThumbWhiteTextWid[framed="false"] {
    background: transparent;
}

ThumbWhiteTextWid[framed="true"] {
    background: #0059D1;
}

ThumbBlueTextWidget,
ThumbMiuzBlueTextWidget {
    background: transparent;
    color: #6E6E6E;
    font-size: 11px;
}

GridTagWidget {
    background: #4e4e4e;
    border: 1px solid #585858;
    border-radius: 10px;
    color: #ffffff;
}

