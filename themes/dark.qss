/* ==========================================================================
   1. ПАЛИТРА И ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ (Справочник цветов)
   ========================================================================== */
/* 
   СИНИЙ (Акцент):            #0059d1 / #0078D4
   ФОН ТЕМНЫЙ:                #1e1e1e (Основной) / #171717 (Потемнее)
   ФОН СВЕТЛЫЙ (Панели):      #2b2b2b
   ГРАНИЦЫ / СЕТКИ:           #353535
   ТЕКСТ:                     #ffffff (Белый) / #818181 / #888888 (Серый)
*/

/* ==========================================================================
   2. БАЗОВЫЕ ЭЛЕМЕНТЫ QT (Глобальные стили)
   ========================================================================== */
.UFrame {
    background: #1e1e1e;
    border: none;
}

QLabel {
    color: #ffffff;
}

QScrollArea {
    background: transparent;
    border: none;
}

QGroupBox {
    background-color: transparent;
    border: 1px solid #353535;
    border-radius: 6px;
}

HSep {
    background: #353535;
}

GrayTextLabel {
    color: #818181;
}

/* ==========================================================================
   3. КНОПКИ И СЛАЙДЕРЫ (Элементы управления)
   ========================================================================== */
QPushButton {
    background: #4e4e4e;
    border: 1px solid #585858;
    border-radius: 4px;
    color: #ffffff;
    padding-right: 1px; /* Отступ справа, чтобы текст не наезжал на стрелочку */
}

QPushButton:pressed {
    background: #5d5d5d;
    border: 1px solid #6a6a6a;
}

QPushButton::menu-indicator {
    image: url("./icons/common/arrow_down.svg");
    width: 12px;
    height: 12px;
}

QSlider::groove:horizontal {
    background-color: #353535;
    height: 3px;
    border-radius: 1px;
    margin: 0px;
}

QSlider::handle:horizontal {
    background-color: #A2A2A2;
    height: 10px;
    width: 10px;
    border-radius: 5px;
    margin: -4px 0;
    padding: -4px 0px;
}

/* ==========================================================================
   4. ПОЛЯ ВВОДА И СПИНБОКСЫ (Формы)
   ========================================================================== */
QLineEdit {
    color: #ffffff;
    border: 1px solid #353535;
    border-radius: 6px;
    padding-left: 2px;
    padding-right: 28px;
}

ULineEditLight { background: #2b2b2b; }
ULineEditDark  { background: #171717; }

QTextEdit {
    color: #ffffff;
    border: 1px solid #2d2d2d;
    border-radius: 6px;
    padding-left: 2px;
    padding-right: 2px;
}

UTextEditLight { background: #2b2b2b; }
UTextEditDark  { background: #171717; }

USpinBox, QDateEdit {
    background: #3E3E3E;
    color: #ffffff;
    border: 1px solid #4C4C4C;
    border-radius: 4px;
}

USpinBox::up-button, QDateEdit::up-button {
    background: #3E3E3E;
    width: 17px;
    height: 10px;
    margin-top: 2px;
    margin-right: 2px;
    border-radius: 3px;
}

USpinBox::up-button:pressed, QDateEdit::up-button:pressed {
    background: #565656;
}

USpinBox::down-button, QDateEdit::down-button {
    background: #3E3E3E;
    width: 17px;
    height: 10px;
    margin-bottom: 2px;
    margin-right: 2px;
    border-radius: 3px;
}

USpinBox::down-button:pressed, QDateEdit::down-button:pressed {
    background: #565656;
}

USpinBox::up-arrow, QDateEdit::up-arrow {
    image: url("./icons/common/arrow_up.svg");
    width: 9px;
    height: 9px;
}

USpinBox::down-arrow, QDateEdit::down-arrow {
    image: url("./icons/common/arrow_down.svg");
    width: 9px;
    height: 9px;
}

/* ==========================================================================
   5. ВСПЛЫВАЮЩИЕ МЕНЮ (QMenu)
   ========================================================================== */
QMenu {
    background: #2b2b2b;
    border: 1px solid #353535;
    border-radius: 10px;
    padding: 5px 2px 5px 2px; /* верх | право | низ | лево */
}

QMenu::item {
    background: transparent;
    color: #ffffff;
    padding: 5px 30px 5px 10px; /* верх | право | низ | лево */
}

QMenu::item:selected {
    background: #ff4e4e4e;
    color: #ffffff;
}

QMenu::icon {
    padding-left: 5px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    padding-left: 5px; /* Отступ от левого края меню */
}

QMenu::indicator:checked {
    image: url(./icons/common/arrow_down.svg);
}

QMenu::indicator:unchecked {
    image: none; 
}


/* Иконка стрелочки для подменю */
QMenu::right-arrow {
    image: url("./icons/common/arrow_right.svg"); /* Путь к вашей иконке */
    width: 12px;                                 /* Ширина иконки */
    height: 12px;                                /* Высота иконки */
    padding-right: 5px;                          /* Отступ от правого края меню */
}

/* Состояние, когда строка подменю активна/выделена (опционально) */
QMenu::right-arrow:selected {
    image: url("./icons/common/arrow_right.svg"); /* Можно заменить на светлую/другую иконку */
}

/* ==========================================================================
   6. СПИСКИ И ДЕРЕВЬЯ (Дерево элементов)
   ========================================================================== */
QTreeView, QListWidget {
    color: #ffffff;
    background: #171717;
    border: 1px solid #2d2d2d;
    border-radius: 10px;
    padding: 10px 2px 10px 2px; /* верх | право | низ | лево */
}

QTreeView::item, QListWidget::item {
    color: #ffffff;
    background: transparent;
    height: 30px;
}

QTreeView::item:selected, QTreeView::item:selected:!active,
QListWidget::item:selected, QListWidget::item:selected:!active {
    color: #ffffff;
    background: #2b2b2b;
}

QTreeView::branch:has-children:closed { image: url(./icons/common/arrow_right.svg); }
QTreeView::branch:has-children:open   { image: url(./icons/common/arrow_down.svg); }
QTreeView::branch:selected            { background: #2b2b2b; }

QListWidget::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #353535;
    border-radius: 4px;
}

QListWidget::indicator:checked  { image: url(./icons/common/arrow_down.svg); }
QListWidget::indicator:disabled { background-color: #101010; border-color: #222222; }


/* ==========================================================================
   7. КАСТОМНЫЕ КОМПОНЕНТЫ И ЭЛЕМЕНТЫ ИНТЕРФЕЙСА
   ========================================================================== */

/* --- Модуль: Календарь --- */
CalendarBigDate {
    font-size: 25pt;
    color: #b2b2b2;
}

CalendarWeek {
    color: #888888;
    border: none;
    border-bottom: 1px solid #353535;
}

CalendarDay {
    color: #ffffff;
    border: none;
    border-bottom: 1px solid #353535;
}

CalendarDaySelected {
    color: #ffffff;
    background-color: #0078D4;
    font-weight: bold;
    border: none;
    border-radius: 15px; /* Половина от полученного размера (30px) делает квадрат кругом */
    
    /* ХАК ДЛЯ ИДЕАЛЬНОГО КРУГА (При размере виджета 65x50):
       Вычитаем маргины, чтобы получить квадрат 30x30 в центре:
       Ширина: 65px - 17px - 18px = 30px
       Высота: 50px - 10px - 10px = 30px */
    margin-left: 17px;
    margin-right: 18px;
    margin-top: 10px;
    margin-bottom: 10px;
}

/* --- Модуль: Плитки / Карточки (Thumbnails) --- */
ThumbImgWidget { border-radius: 10px; }
ThumbImgWidget[framed="false"] { background: transparent; }
ThumbImgWidget[framed="true"]  { background-color: #3a3a3a; }

WhiteTextWid {
    font-size: 11px;
    border-radius: 5px;
    padding: 2px;
}
WhiteTextWid[framed="false"] { background: transparent; color: #ffffff; }
WhiteTextWid[framed="true"]  { background: #0059d1; color: #ffffff; }

BlueTextWidget, MiuzBlueTextWidget {
    font-size: 11px;
    color: #6e6e6e;
}

/* --- Модуль: Окна просмотра и заголовки --- */
MfAliasTitle {
    color: #ffffff;
    font-size: 23px;
    font-weight: bold;
}

WinImgViewGraphics, BlackBgFrame {
    background: #000000;
}

WinInfoLeftLabel, WinInfoSelectableLabel {
    font-size: 11pt;
}

ServerLabel {
    padding-left: 1px;
}

QToolTip {
    color: #FFFFFF;
    background-color: #2B2B2B;
    border: 1px solid #454545;
    padding: 2px;
}


MfList {
    background: #1e1e1e;
    color: #818181;
    border: 1px solid #2a2a2a;
    /* border: none; */
    border-radius: 8px;
    font-weight: bold;
    font-size: 15px;
}

MfList:pressed {
    background: #1e1e1e;
    color: #818181;
    border: 1px solid #2a2a2a;
    /* border: none; */
    border-radius: 8px;
    font-weight: bold;
    font-size: 15px;
}