QFrame {
    background: #1e1e1e;
    border: none;
}




QMenu {
    background: #2b2b2b;
    border: 1px solid #353535;
    border-radius: 8px;
    padding: 3px;
}

QMenu::item {
    background: transparent;
    padding: 3px 16px;
    margin: 0px;
    border-radius: 4px;
    color: #ffffff;
}

QMenu::item:selected {
    background: #0059d1;
    color: #ffffff;
    border-radius: 4px;
}




QScrollArea {
    border: none;
}






QLineEdit {
    background: #2b2b2b;
    color: #ffffff;
    border: 1px solid #353535;
    border-radius: 6px;
    padding-left: 2px;
    padding-right: 28px;
}

QLineEdit::placeholder {
    color: #9a3636;
}






QGroupBox {
    background-color: #2b2b2b;
    border: 1px solid #353535;
    border-radius: 6px;
}




QListWidget {
    background: #171717;
    color: #ffffff;
}

QListWidget::item:selected {
    background: #0059d1;
    color: #ffffff;
}

QListWidget::item:selected:!active {
    background: #0059d1;
    color: #ffffff;
}




QTreeWidget {
    background: #171717;
    color: #ffffff;
}

QTreeWidget::item:selected {
    background: #0059d1;
    color: #ffffff;
}

QTreeWidget::item:selected:!active {
    background: #0059d1;
    color: #ffffff;
}

QPushButton {
    font-size: 11pt;
    background: #2b2b2b;
    border: 1px solid #353535;
    border-radius: 4px;
    color: #ffffff;
}
