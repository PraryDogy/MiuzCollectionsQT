.QFrame {
    background: #1e1e1e;
    border: none;
}


QLabel {
    color: #ffffff;
}



QMenu {
    background: #2b2b2b;
    border: 1px solid #353535;
    border-radius: 8px;
    padding: 3px;
}

QMenu::item {
    background: transparent;
    padding: 3px 16px;
    margin: 0px;
    border-radius: 4px;
    color: #ffffff;
}

QMenu::item:selected {
    background: #0059d1;
    color: #ffffff;
    border-radius: 4px;
}




QScrollArea {
    border: none;
    background: transparent;
}




QLineEdit {
    color: #ffffff;
    border: 1px solid #353535;
    border-radius: 6px;
    padding-left: 2px;
    padding-right: 28px;
}

ULineEditLight {
    background: #2b2b2b;
}


ULineEditDark {
    background: #232323;
}





QTextEdit {
    color: #ffffff;
    border: 1px solid #353535;
    border-radius: 6px;
    padding-left: 2px;
    padding-right: 28px;
}


UTextEditLight {
    background: #2b2b2b;
}


UTextEditDark {
    background: #232323;
}




QGroupBox {
    background-color: #2b2b2b;
    border: 1px solid #353535;
    border-radius: 6px;
}




QListWidget {
    background: #171717;
    color: #ffffff;
}

QListWidget::item:selected {
    background: #0059d1;
    color: #ffffff;
}

QListWidget::item:selected:!active {
    background: #0059d1;
    color: #ffffff;
}




QTreeWidget {
    background: #171717;
    color: #ffffff;
}

QTreeWidget::item:selected {
    background: #0059d1;
    color: #ffffff;
}

QTreeWidget::item:selected:!active {
    background: #0059d1;
    color: #ffffff;
}




QTreeView {
    background: #171717;
    color: #ffffff;
}

QTreeView::item:selected {
    background: #0059d1;
    color: #ffffff;
}

QTreeView::item:selected:!active {
    background: #0059d1;
    color: #ffffff;
}




QPushButton {
    background: #4e4e4e;
    border: 1px solid #585858;
    border-radius: 4px;
    color: #ffffff;
}

QPushButton:pressed {
    background: #5d5d5d;
    border: 1px solid #6a6a6a;
}




HSep {
    background: #353535;
}


GrayLabel {
    color: #818181;
}




QSlider::groove:horizontal {
    border-radius: 1px;
    height: 3px;
    margin: 0px;
    background-color: #353535;
}

QSlider::handle:horizontal {
    background-color: #A2A2A2;
    height: 10px;
    width: 10px;
    border-radius: 5px;
    margin: -4px 0;
    padding: -4px 0px;
}





USpinBox {
    background: #3E3E3E;
    color: #ffffff;
    border: 1px solid #4C4C4C;
    border-radius: 4px;
}

USpinBox::up-button {
    width: 17px;
    height: 10px;
    background: #3E3E3E;
    margin-top: 2px;
    margin-right: 2px;
    border-radius: 3px;
}

USpinBox::up-button:pressed {
    background: #565656;
}

USpinBox::down-button {
    width: 17px;
    height: 10px;
    background: #3E3E3E;
    margin-bottom: 2px;
    margin-right: 2px;
    border-radius: 3px;
}

USpinBox::down-button:pressed {
    background: #565656;
}

USpinBox::up-arrow {
    image: url("./icons/common/arrow_up.svg");
    width: 9px;
    height: 9px;
}

USpinBox::down-arrow {
    image: url("./icons/common/arrow_down.svg");
    width: 9px;
    height: 9px;
}



ReadableDateLabel {
    color: #7d7d7d; 
    font-weight: 500;
}