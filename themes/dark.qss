.QFrame {
    background: #1e1e1e;
    border: none;
}


QLabel {
    color: #ffffff;
}



QMenu {
    background: #2b2b2b;
    border: 1px solid #353535;
    border-radius: 10px;
    padding: 5px;
}

QMenu::item {
    background: transparent;
    color: #ffffff;
    padding: 5px 30px 5px 5px; 
}

QMenu::item:selected {
    background: #0059d1;
    color: #ffffff;
    padding: 5px 30px 5px 5px; 
}

QMenu::icon {
    padding-left: 5px;
}


QMenu::indicator {
    width: 16px;
    height: 16px;
    padding-left: 5px; /* Отступ от левого края меню */
}

QMenu::indicator:checked {
    image: url(./icons/common/arrow_down.svg);
}

QMenu::indicator:unchecked {
    image: none; 
}




QScrollArea {
    border: none;
    background: transparent;
}


QLineEdit {
    color: #ffffff;
    border: 1px solid #353535;
    border-radius: 6px;
    padding-left: 2px;
    padding-right: 28px;
}

ULineEditLight {
    background: #2b2b2b;
}


ULineEditDark {
    background: #171717;
}


MfAliasTitle {
    color: #ffffff;
    font-size: 23px;
    font-weight: bold;
}


QTextEdit {
    color: #ffffff;
    border: 1px solid #353535;
    border-radius: 6px;
    padding-left: 2px;
    padding-right: 2px;
}

UTextEditLight {
    background: #2b2b2b;
}

UTextEditDark {
    background: #171717;
}



QGroupBox {
    background-color: transparent;
    border: 1px solid #353535;
    border-radius: 6px;
}



QTreeView,
QListWidget {
    color: #ffffff;
    background: #171717;
    border-radius: 10px;
    padding: 5px 5px 5px 5px;
    border: 1px solid #353535;
}


QTreeView::item,
QListWidget::item {
    color: #ffffff;
    background: transparent;
    height: 30px;
}

QTreeView::item:selected,
QTreeView::item:selected:!active,
QListWidget::item:selected,
QListWidget::item:selected:!active {
    color: #ffffff;
    background: #2b2b2b;
    height: 30px;
}

QTreeView::branch:has-children:closed {
    image: url(./icons/common/arrow_right.svg); 
}


QTreeView::branch:has-children:open {
    image: url(./icons/common/arrow_down.svg); 
}

QTreeView::branch:selected {
    background: #2b2b2b;
}


/* Общий стиль для чекбокса (не отмечен) */
QListWidget::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #353535;
    border-radius: 4px;
}


QListWidget::indicator:checked {
    image: url(./icons/common/arrow_down.svg); 
}

QListWidget::indicator:disabled {
    background-color: #101010;
    border-color: #222222;
}



QPushButton {
    background: #4e4e4e;
    border: 1px solid #585858;
    border-radius: 4px;
    color: #ffffff;
    /* Добавляем отступ справа, чтобы текст не наезжал на стрелочку */
    padding-right: 1px; 
}

QPushButton:pressed {
    background: #5d5d5d;
    border: 1px solid #6a6a6a;
}

/* Стилизация стрелочки меню */
QPushButton::menu-indicator {
    image: url("./icons/common/arrow_down.svg");
    width: 12px; /* Ширина иконки */
    height: 12px; /* Высота иконки */
}



HSep {
    background: #353535;
}


GrayTextLabel {
    color: #818181;
}




QSlider::groove:horizontal {
    border-radius: 1px;
    height: 3px;
    margin: 0px;
    background-color: #353535;
}

QSlider::handle:horizontal {
    background-color: #A2A2A2;
    height: 10px;
    width: 10px;
    border-radius: 5px;
    margin: -4px 0;
    padding: -4px 0px;
}





USpinBox, QDateEdit {
    background: #3E3E3E;
    color: #ffffff;
    border: 1px solid #4C4C4C;
    border-radius: 4px;
}

USpinBox::up-button, QDateEdit::up-button {
    width: 17px;
    height: 10px;
    background: #3E3E3E;
    margin-top: 2px;
    margin-right: 2px;
    border-radius: 3px;
}

USpinBox::up-button:pressed, QDateEdit::up-button:pressed {
    background: #565656;
}

USpinBox::down-button, QDateEdit::down-button {
    width: 17px;
    height: 10px;
    background: #3E3E3E;
    margin-bottom: 2px;
    margin-right: 2px;
    border-radius: 3px;
}

USpinBox::down-button:pressed, QDateEdit::down-button:pressed {
    background: #565656;
}

USpinBox::up-arrow, QDateEdit::up-arrow {
    image: url("./icons/common/arrow_up.svg");
    width: 9px;
    height: 9px;
}

USpinBox::down-arrow, QDateEdit::down-arrow {
    image: url("./icons/common/arrow_down.svg");
    width: 9px;
    height: 9px;
}




CalendarBigDate {
    font-size: 30pt;
    color: #b2b2b2;
}

CalendarWeek {
    color: #888888;
    border: none;
    border-bottom: 1px solid #353535;
}

CalendarDay {
    color: #ffffff;
    border: none;
    border-bottom: 1px solid #353535;
}


CalendarDaySelected {
    color: #ffffff;
    background-color: #0078D4;
    font-weight: bold;
    border: none;
    /* ХАК ДЛЯ ИДЕАЛЬНОГО КРУГА (При размере виджета 70x60):
       Вычитаем маргины из общего размера, чтобы получить квадрат 40x40 в центре:
       Ширина: 70px - 15px (слева) - 15px (справа) = 40px
       Высота: 60px - 10px (сверху) - 10px (снизу) = 40px
       Бордер радиус 20 + 20 = 4px */
    border-radius: 20px;
    margin-left: 15px;
    margin-right: 15px;
    margin-top: 10px;
    margin-bottom: 10px;
}


WinImgViewGraphics, BlackBgFrame {
    background: #000000;
}

WinInfoLeftLabel, WinInfoSelectableLabel {
    font-size: 11pt;
}

ServerLabel {
    padding-left: 1px;
}


/* Базовый стиль для вашего виджета (скругление применяется всегда) */
ThumbImgWidget {
    border-radius: 10px;
}

/* Стиль, когда свойство framed=false (без рамки) */
ThumbImgWidget[framed="false"] {
    background: transparent;
}

/* Стиль, когда свойство framed=true (с рамкой) */
ThumbImgWidget[framed="true"] {
    background-color: #3a3a3a;
}


/* Базовые стили для виджета, общие для обоих состояний */
WhiteTextWid {
    font-size: 11px;
    border-radius: 5px;
    padding: 2px;
}

/* Состояние: Без рамки (framed = false) */
WhiteTextWid[framed="false"] {
    background: transparent;
    color: #ffffff;
}

/* Состояние: С рамкой (framed = true) */
WhiteTextWid[framed="true"] {
    background: #0059d1;
    color: #ffffff;
}


BlueTextWidget {
    font-size: 11px;
    color: #767676;
}
