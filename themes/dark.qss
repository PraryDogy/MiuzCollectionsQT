/* СИНИЙ */
/* #0059d1 */

/* ФОН line edit, text edit, menu */
/* #2b2b2b */

/* БОРДЕР line edit, text edit, menu */
/* #353535 */



UMenu {
    background: #2b2b2b;
    border: 1px solid #353535;
    border-radius: 8px;
    padding: 3px;
}

UMenu::item {
    background: transparent;
    padding: 3px 16px;
    margin: 0px;
    border-radius: 4px;
    color: #ffffff;
}

/* Стиль выделенного (активного) пункта меню */
UMenu::item:selected {
    background: #0059d1;
    color: #ffffff;
    border-radius: 4px;
}

VScrollArea {
    border: none;
}

ULineEdit {
    background: #2b2b2b;
    color: #ffffff;
    border: 1px solid #353535;
    border-radius: 6px;
    padding-left: 2px;
    padding-right: 28px;
}


/* Если в вашем приложении используются обычные диалоговые окна (QDialog), 
   их фон тоже можно объединить в это правило через запятую: */
QMainWindow, QDialog, .QWidget {
    background: #1e1e1e;
}
