/* background: #0059D1; */

/* _base_widgets.py */

TransparentButton,
TransparentLabel,
TransparentFrame,
TransparentWidget,
TransparentLineEdit,
TransparentTextEdit,
TransparentMenu,
TransparentScrollArea,
UGroupBox,
TransparentListWidget,
TransparentTreeWidget,
TransparentTreeView {
    background: transparent;
    border: none;
}

UGroupBox {
    background: #202020
}

UMainWindow,
UMainWidget {
    background: #151515;
}


UMenu {
    background: #2b2b2b;
    border: 1px solid #353535;
    border-radius: 10px;
    padding: 5px 2px 5px 2px; /* верх | право | низ | лево */
}

UMenu::item {
    background: transparent;
    color: #ffffff;
    padding: 5px 30px 5px 10px; /* верх | право | низ | лево */
}

UMenu::item:selected {
    background: #ff4e4e4e;
    color: #ffffff;
}

UMenu::icon {
    padding-left: 5px;
}

UMenu::indicator {
    width: 16px;
    height: 16px;
    padding-left: 5px; /* Отступ от левого края меню */
}

UMenu::indicator:checked {
    image: url(./icons/common/arrow_down.svg);
}

UMenu::indicator:unchecked {
    image: none; 
}

/* Иконка стрелочки для подменю */
UMenu::right-arrow {
    image: url("./icons/common/arrow_right.svg"); /* Путь к вашей иконке */
    width: 12px;                                 /* Ширина иконки */
    height: 12px;                                /* Высота иконки */
    padding-right: 5px;                          /* Отступ от правого края меню */
}

/* Состояние, когда строка подменю активна/выделена (опционально) */
UMenu::right-arrow:selected {
    image: url("./icons/common/arrow_right.svg"); /* Можно заменить на светлую/другую иконку */
}

ULineEdit {
    color: #ffffff;
    border: 1px solid #353535;
    border-radius: 6px;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 5px;
    padding-bottom: 5px;
}


UTextEdit {
    color: #ffffff;
    border: 1px solid #2d2d2d;
    border-radius: 6px;
    padding-left: 2px;
    padding-right: 2px;
}


UScrollVerticalArea {
    background: transparent;
}


UTreeView,
UListWidget,
UTreeWidget {
    color: #ffffff;
    background: #171717;
    border: 1px solid #2d2d2d;
    border-radius: 10px;
    padding: 10px 2px 10px 2px; /* верх | право | низ | лево */
}


UTreeView::item,
UListWidget::item,
UTreeWidget::item {
    color: #ffffff;
    background: transparent;
    height: 30px;
}


UTreeView::item:selected,
UTreeView::item:selected:!active,
UListWidget::item:selected,
UListWidget::item:selected:!active,
UTreeWidget::item:selected,
UTreeWidget::item:selected:!active {
    color: #ffffff;
    background: #2b2b2b;
}


UTreeView::branch:has-children:closed,
UTreeWidget::branch:has-children:closed {
    image: url(./icons/common/plus.svg);
}

UTreeView::branch:has-children:open,
UTreeWidget::branch:has-children:open {
    image: url(./icons/common/minus.svg);
}

UTreeView::branch:selected,
UTreeWidget::branch:selected {
    background: #2b2b2b;
}


UListWidget::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #353535;
    border-radius: 4px;
}

UListWidget::indicator:checked {
    image: url(./icons/common/arrow_down.svg);
}

UListWidget::indicator:disabled {
    background-color: #101010;
    border-color: #222222;
}


UPushButton {
    background: #4e4e4e;
    border: 1px solid #585858;
    border-radius: 6px;
    color: #ffffff;
    padding-right: 1px; /* Отступ справа, чтобы текст не наезжал на стрелочку */
}

UPushButton:pressed {
    background: #5d5d5d;
    border: 1px solid #6a6a6a;
}

UPushButton::menu-indicator {
    image: url("./icons/common/arrow_down.svg");
    width: 12px;
    height: 12px;
}


USep {
    background: #363636;
}





USlider::groove:horizontal {
    background-color: #353535;
    height: 3px;
    border-radius: 1px;
    margin: 0px;
}

USlider::handle:horizontal {
    background-color: #A2A2A2;
    height: 10px;
    width: 10px;
    border-radius: 5px;
    margin: -4px 0;
    padding: -4px 0px;
}


USpinBox {
    background: #3E3E3E;
    color: #ffffff;
    border: 1px solid #4C4C4C;
    border-radius: 4px;
}

USpinBox::up-button {
    background: #3E3E3E;
    width: 17px;
    height: 10px;
    margin-top: 2px;
    margin-right: 2px;
    border-radius: 3px;
}

USpinBox::up-button:pressed {
    background: #565656;
}

USpinBox::down-button {
    background: #3E3E3E;
    width: 17px;
    height: 10px;
    margin-bottom: 2px;
    margin-right: 2px;
    border-radius: 3px;
}

USpinBox::down-button:pressed {
    background: #565656;
}

USpinBox::up-arrow {
    image: url("./icons/common/arrow_up.svg");
    width: 9px;
    height: 9px;
}

USpinBox::down-arrow {
    image: url("./icons/common/arrow_down.svg");
    width: 9px;
    height: 9px;
}


UGroupBox {
    border: 1px solid #363636;
    border-radius: 10px;
}


QToolTip {
    color: #FFFFFF;
    background-color: #2B2B2B;
    border: 1px solid #454545;
    padding: 2px;
}


GrayTextLabel {
    color: #676767;
}

TitleTextLabel {
    font-weight: bold;
    font-size: 20px;
}

