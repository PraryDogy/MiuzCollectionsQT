/* --- Модуль: Плитки / Карточки (Thumbnails) --- */
ThumbImgWidget { border-radius: 10px; }
ThumbImgWidget[framed="false"] { background: transparent; color: #AAAAAA;}
ThumbImgWidget[framed="true"]  { background-color: #363636; color: #AAAAAA;}

ThumbWhiteTextWid {
    font-size: 11px;
    border-radius: 5px;
    padding: 2px;
}
ThumbWhiteTextWid[framed="false"] { background: transparent; color: #ffffff; }
ThumbWhiteTextWid[framed="true"]  { background: #0059d1; color: #ffffff; }

ThumbBlueTextWidget, ThumbMiuzBlueTextWidget {
    font-size: 11px;
    color: #6e6e6e;
    background: transparent;
}

/* --- Модуль: Окна просмотра и заголовки --- */
WinSettingsMfAliasTitle {
    color: #ffffff;
    font-size: 23px;
    font-weight: bold;
}

WinImgViewGraphics, BlackBgFrame {
    background: #000000;
}


ServerLabel {
    padding-left: 1px;
}



LeftMenuTreeWidget,
LeftMenuCatalogTitle {
    background: transparent;
    border: none;
    color: #AAAAAA
}

LeftMenuCatalogTitle {
    font-weight: bold;
    margin-left: 2px;
}


LeftMenuSep {
    margin-left: 5px;
    margin-right: 5px;
}

LeftMenuSep[hidden="true"] {
    background: transparent;
}

LeftMenuSep[hidden="false"]  {
    background: #2d2d2d;
}


MenuLeft,
MainWinRightWidget {
    background: #272727;
    border: 1px solid #2d2d2d;
    border-radius: 10px;
}


LeftMenuTreeWidget::item:selected,
LeftMenuTreeWidget::item:selected:!active,
LeftMenuTreeWidget::branch:selected {
    background: #363636;
}


GridTagWidget {
    background: #4e4e4e;
    border: 1px solid #585858;
    border-radius: 6px;
    color: #ffffff;
}


WinTextSearchTitle {
    /* font-family: "SF Pro Rounded"; */
    font-weight: bold;
    font-size: 30px;
    /* color: #d5d5d5; */
}

WinTextSearchSubtitle {
    color: #AAAAAA;
}
