/* =====================================================================
   ТЁМНАЯ ТЕМА

   Слои различаются фоном и рамкой. Цвет акцента используется только
   для действий и состояний: основная кнопка, теги, активная зона.

   Палитра (по ролям):
     Фоны
       #000000                  просмотр изображений, превью поиска
       #080b0f                  окно (UMainWindow)
       #10161d                  UFrame
       #141c25                  UGroupBox, списки, деревья, таблицы, меню
       #1d2834                  кнопки, поля, спинбокс, тултип, шапка таблицы
       #121a23                  зона перетаскивания
       #19232e                  UGroupBox
       #1b2530                  HoverGroupBox в базовом состоянии
       #243241                  HoverGroupBox при наведении
       rgba(40, 54, 69, 200)    кнопка «вверх»
       rgba(0, 0, 0, 150)       затемнение окна
     Рамки (приглушённые)
       #223040                  рамка UFrame, групп, списков, таблиц, меню
       #26333f                  рамка UGroupBox, HoverGroupBox
       #2b3947                  рамка кнопок, полей, спинбокса, тегов
       #3a4b5e                  рамка при наведении
       #4a5d72                  рамка индикаторов при наведении
     Состояния
       #22303f                  наведение строк, выделение, отметка
       #263446                  наведение кнопок и полей
       #2f3f53                  нажатие, иконочная кнопка: выбрано
       #5d7490                  полоса прокрутки: нажатие
     Текст
       #c9d1da                  основной текст
       #f2f5f8                  текст на заливке кнопок и тегов
       #9aa6b2                  серый текст подписей
     Акцент (только действия и состояния)
       #0a6ce0                  ActiveButton, синий тег
       #1a7cf0                  ActiveButton: наведение и рамка
       #0859bd                  ActiveButton: нажатие
       #2f5f96                  пунктирная рамка зоны перетаскивания (не используется)
     Теги
       #303b46 / #3d4a56        серый
       #064e3b / #10b981        зелёный
       #3a2c12 / #6b5420        жёлтый
       #7f1d1d / #ef4444        красный
     Слайдер
       #3a4d61                  дорожка
       #aab6c2                  ползунок
     Base-слой
       #131b24                  BaseGroupBox, UListWidget, UTreeView, UTreeWidget
       #17202a                  рамка Base-слоя

   ВАЖНО: цвет выделения списков (#22303f) дублируется в system/themes.py,
   класс DarkTreeTheme.sel_color. При смене цвета меняйте в обоих местах.
   Выделение дерева (UTreeView, UTreeWidget) рисует делегат, в QSS его нет.
   ===================================================================== */


/* =====================================================================
   ПРОЗРАЧНЫЕ ОБЁРТКИ
   ===================================================================== */

TransparentButton,
TransparentFrame,
TransparentWidget,
TransparentLineEdit,
TransparentTextEdit,
TransparentMenu,
TransparentScrollArea,
ImgViewSvg {
    background: transparent;
    border: none;
    color: #c9d1da;
}

/* проверить: grep по коду, используется ли класс */
MacControlButton {
    background: transparent;
    border: none;
    color: #c9d1da;
}


/* =====================================================================
   ОКНО, ФРЕЙМЫ И ПАНЕЛИ
   ===================================================================== */

UMainWindow {
    background: #080b0f;
    border: none;
    color: #c9d1da;
}

UFrame {
    background: #10161d;
    border: 1px solid #223040;
    border-radius: 8px;
    color: #c9d1da;
}

/* рамка прозрачна, чтобы не было сдвига при изменении */
UBlackFrame {
    background: #000000;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #c9d1da;
}

LightGroupBox {
    background: #19232e;
    border: 1px solid #26333f;
    border-radius: 8px;
    color: #c9d1da;
}

LightHoverGroupBox {
    background: #19232e;
    border: 1px solid #26333f;
    border-radius: 8px;
}

LightHoverGroupBox[hovered="true"] {
    background: #1e2a37;
    border: 1px solid #3a4b5e;
}

USep {
    background: #223040;
    border: none;
    color: #c9d1da;
}

DarkGroupBox {
    background: #131b24;
    border: 1px solid #17202a;
    border-radius: 8px;
    color: #c9d1da;
}


/* Миниатюры */
/* PY: размер миниатюры — setFixedSize в коде.
   Рамка остаётся в QSS, потому что меняется при выделении. */
Thumb {
    border-radius: 8px;
}

Thumb[framed="noframe"] {
    border: 2px solid transparent;
}

Thumb[framed="frame"] {
    border: 2px solid #0a6ce0;
}

SquareThumb {
    background: #19232e;
}

/* PY: размер плитки — setFixedSize, отступы — setContentsMargins. */
ThumbImgWidget {
    background: #1a232d;
    border-radius: 6px;
}

/* PY: размер шрифта 11px — QFont в коде. */
ThumbFilenameWid {
    font-size: 11px;
}

/* PY: размер шрифта 11px — QFont в коде. */
ThumbBlueTextWidget {
    font-size: 11px;
}

/* PY: размер шрифта 11px — QFont в коде. */
ThumbMiuzBlueTextWidget {
    font-size: 11px;
}

_TitleTextLabel {
    font-weight: bold;
    font-size: 20px;
}


/* Чёрные области: просмотр изображений, превью поиска */
WinImgViewGraphics,
WinImageView {
    background: #000000;
    border-radius: 8px;
}

/* Зона перетаскивания: нейтральная, статус передаёт иконка */
WinImgSearchDropWidget {
    background: #121a23;
    border: 2px dashed #2b3947;
    border-radius: 8px;
}

UpBtnLabel {
    background: rgba(40, 54, 69, 255);
    border: 1px solid #2b3947;
    border-radius: 18px;
    color: #c9d1da;
}

UMainWinOverlay {
    background: rgba(0, 0, 0, 150);
    border-radius: 8px;
}


/* =====================================================================
   КНОПКИ
   ===================================================================== */

UPushButton {
    background: #1d2834;
    border: 1px solid #2b3947;
    border-radius: 8px;
    color: #c9d1da;
    font-size: 11px;
    padding-left: 5px;
    padding-right: 5px;
}

UPushButton:hover {
    background: #263446;
    border: 1px solid #3a4b5e;
}

UPushButton:pressed {
    background: #2f3f53;
    border: 1px solid #3a4b5e;
}

UPushButton::menu-indicator {
    width: 12px;
    height: 12px;
    image: url("./icons/gray/arrow_down.svg");
}

/* Основное действие: единственная кнопка с полным акцентом */
ActiveButton {
    background: #0a6ce0;
    border: 1px solid #1a7cf0;
    color: #f2f5f8;
}

ActiveButton:hover {
    background: #1a7cf0;
    border: 1px solid #3a8cf5;
}

ActiveButton:pressed {
    background: #0859bd;
    border: 1px solid #0a6ce0;
}

AccentButton {
    background: #15447f;
    border: 1px solid #2a5c98;
    color: #e6eefc;
}

AccentButton:hover {
    background: #1b5394;
    border: 1px solid #3a6fb0;
}

AccentButton:pressed {
    background: #0d2c52;
    border: 1px solid #2a5c98;
}

RedButton {
    background: #d11f2e;
    border: 1px solid #e0313f;
    color: #f2f5f8;
}

RedButton:hover {
    background: #dc2a39;
    border: 1px solid #f04a57;
}

RedButton:pressed {
    background: #e0313f;
    border: 1px solid #f04a57;
}


SvgBg {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #c9d1da;
}

SvgBg:hover[style="base"] {
    background: #263446;
}

SvgBg[style="selected"] {
    background: #2f3f53;
}

SvgBg[style="pressed"] {
    background: #3a4d61;
}


/* =====================================================================
   ПОЛЯ ВВОДА
   ===================================================================== */

ULineEdit {
    background: #1d2834;
    border: 1px solid #2b3947;
    border-radius: 6px;
    color: #c9d1da;
    padding: 5px 2px 5px 2px;
}

ULineEdit:hover {
    background: #263446;
    border: 1px solid #3a4b5e;
}

USpinBox {
    background: #1d2834;
    border: 1px solid #2b3947;
    border-radius: 4px;
    color: #c9d1da;
}

USpinBox:hover {
    background: #263446;
    border: 1px solid #3a4b5e;
}

USpinBox::up-button,
USpinBox::down-button {
    background: transparent;
    border: none;
    color: #c9d1da;
    width: 17px;
    height: 9px;
    border-radius: 3px;
}

USpinBox::up-button {
    margin-top: 2px;
    margin-right: 2px;
}

USpinBox::down-button {
    margin-bottom: 2px;
    margin-right: 2px;
}

USpinBox::up-button:pressed,
USpinBox::down-button:pressed {
    background: #2f3f53;
    border: none;
}

USpinBox::up-arrow {
    width: 9px;
    height: 9px;
    image: url("./icons/gray/arrow_up.svg");
}

USpinBox::down-arrow {
    width: 9px;
    height: 9px;
    image: url("./icons/gray/arrow_down.svg");
}

SearchWidLineEdit {
    padding-left: 25px;
    padding-right: 25px;
}

BarTopLineEdit {
    background: transparent;
}

BarTopLineEdit:focus {
    background: #1d2834;
}


/* =====================================================================
   ЧЕКБОКСЫ И ОТМЕТКИ
   ===================================================================== */

UCheckBox {
    spacing: 5px;
}

UCheckBox::indicator {
    background: #1d2834;
    border: 1px solid #3a4b5e;
    width: 12px;
    height: 12px;
    border-radius: 4px;
}

UCheckBox::indicator:checked {
    image: url(./icons/gray/checkmark.svg);
}

UCheckBox::indicator:unchecked {
    image: none;
}

UCheckBox::indicator:hover {
    border: 1px solid #4a5d72;
}

UListWidget::indicator {
    background: #1d2834;
    border: 1px solid #3a4b5e;
    width: 16px;
    height: 16px;
    border-radius: 4px;
}

UListWidget::indicator:disabled {
    background: #1d2834;
    border: 1px solid #2b3947;
}

UListWidget::indicator:checked {
    image: url(./icons/gray/checkmark.svg);
}


/* =====================================================================
   МЕНЮ
   ===================================================================== */

UMenu {
    background: #141c25;
    border: 1px solid #223040;
    border-radius: 8px;
    color: #c9d1da;
    padding: 5px 2px 5px 2px;
}

UMenu::item {
    background: transparent;
    border: none;
    color: #c9d1da;
    padding: 5px 30px 5px 10px;
}

UMenu::item:selected {
    background: #22303f;
    border-radius: 6px;
}

UMenu::icon {
    padding-left: 5px;
}

UMenu::indicator {
    width: 16px;
    height: 16px;
    padding-left: 5px;
}

UMenu::indicator:checked {
    image: url(./icons/gray/checkmark.svg);
}

UMenu::indicator:unchecked {
    image: none;
}

UMenu::right-arrow {
    width: 12px;
    height: 12px;
    padding-right: 5px;
    image: url("./icons/gray/arrow_right.svg");
}

UMenu::right-arrow:selected {
    image: url("./icons/gray/arrow_right.svg");
}


/* =====================================================================
   СПИСКИ
   ===================================================================== */

UListWidget {
    background: #131b24;
    border: 1px solid #17202a;
    border-radius: 8px;
    color: #c9d1da;
    padding: 4px 4px 4px 4px;
}

UListWidget::item {
    background: transparent;
    border: none;
    color: #c9d1da;
    height: 30px;
}

UListWidget::item:selected,
UListWidget::item:selected:!active {
    background: #22303f;
    border-radius: 6px;
}


/* =====================================================================
   ДЕРЕВЬЯ
   ===================================================================== */

UTreeView,
UTreeWidget {
    background: #131b24;
    border: 1px solid #17202a;
    border-radius: 8px;
    color: #c9d1da;
    padding: 4px 4px 4px 4px;
}

UTreeView::item,
UTreeWidget::item {
    background: transparent;
    border: none;
    color: #c9d1da;
    height: 30px;
}

UTreeView::branch:has-children:closed,
UTreeWidget::branch:has-children:closed {
    image: url(./icons/gray/expand.svg);
}

UTreeView::branch:has-children:open,
UTreeWidget::branch:has-children:open {
    image: url(./icons/gray/collapse.svg);
}


/* =====================================================================
   ТЕГИ
   ===================================================================== */

TagWidget {
    background: transparent;
    border: none;
    border-radius: 12px;
    color: #c9d1da;
}

TagWidget[style="blue"] {
    background: #0a6ce0;
    border: 1px solid #1a7cf0;
    color: #f2f5f8;
}

TagWidget[style="blue"]:hover {
    background: #1a7cf0;
    border: 1px solid #3a8cf5;
}

TagWidget[style="gray"] {
    background: #303b46;
    border: 1px solid #36424f;
}

TagWidget[style="gray"]:hover {
    background: #3a4754;
    border: 1px solid #434f5c;
}

TagWidget[style="green"] {
    background: #064e3b;
    border: 1px solid #10b981;
    color: #f2f5f8;
}

TagWidget[style="green"]:hover {
    background: #075f48;
    border: 1px solid #34d399;
}

TagWidget[style="yellow"] {
    background: #3a2c12;
    border: 1px solid #6b5420;
}

TagWidget[style="yellow"]:hover {
    background: #4a3816;
    border: 1px solid #8a6d2a;
}

TagWidget[style="red"] {
    background: #7f1d1d;
    border: 1px solid #ef4444;
    color: #f2f5f8;
}

TagWidget[style="red"]:hover {
    background: #952323;
    border: 1px solid #f87171;
}

TagWidget[style="transparent"] {
    border: 1px solid #2b3947;
}

TagWidget[style="transparent"]:hover {
    background: #22303f;
    border: 1px solid #3a4b5e;
}


/* =====================================================================
   СЛАЙДЕР
   ===================================================================== */

USlider::groove:horizontal {
    background-color: #3a4d61;
    height: 3px;
    border-radius: 1px;
    margin: 0px;
}

/* проверить: по расчёту нужно 3.5px */
USlider::handle:horizontal {
    background-color: #aab6c2;
    height: 10px;
    width: 10px;
    border-radius: 5px;
    margin: -4px 0;
}


/* =====================================================================
   ПОЛОСА ПРОКРУТКИ
   width / height — полный размер области, margin — отступ от краёв.
   Видимая ширина = 14 - 3 - 3 = 8px, скругление = 4px.
   ===================================================================== */

QScrollBar {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    width: 14px;
    margin: 4px 3px 4px 3px;
}

QScrollBar:horizontal {
    height: 14px;
    margin: 3px 4px 3px 4px;
}

QScrollBar::handle:vertical {
    background: #3a4d61;
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #4f6680;
}

QScrollBar::handle:vertical:pressed {
    background: #5d7490;
}

QScrollBar::handle:horizontal {
    background: #3a4d61;
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #4f6680;
}

QScrollBar::handle:horizontal:pressed {
    background: #5d7490;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
    border: none;
    background: none;
}


/* =====================================================================
   ТЕКСТОВЫЕ МЕТКИ
   ===================================================================== */

TransparentLabel,
WrapLabel {
    background: transparent;
    border: none;
    color: #c9d1da;
}

TransparentLabel[state="regular"],
WrapLabel[state="regular"] {
    color: #c9d1da;
}

TransparentLabel[state="gray"],
WrapLabel[state="gray"] {
    color: #9aa6b2;
}

TransparentLabel[text_weight="regular"],
WrapLabel[text_weight="regular"] {
    font-weight: normal;
}

TransparentLabel[text_weight="bold"],
WrapLabel[text_weight="bold"] {
    font-weight: bold;
}

TransparentLabel[text_size="small"],
WrapLabel[text_size="small"] {
    font-size: 11px;
}

TransparentLabel[text_size="big"],
WrapLabel[text_size="big"] {
    font-size: 20px;
}

CalendarCircle[circle="selected"] {
    background: #0a6ce0;
    border-radius: 13px;
    color: #f2f5f8;
    font-weight: bold;
}

CalendarCircle[circle="today"] {
    background: #303b46;
    border-radius: 13px;
    color: #c9d1da;
}

QToolTip {
    background: #1d2834;
    border: 1px solid #3a4b5e;
    color: #c9d1da;
    padding: 2px;
    font-weight: bold;
    font-size: 13px;
}


/* =====================================================================
   ВЫБОР ПУТИ
   Состояние (warn / ok) передаётся иконкой в коде, не цветом зоны.
   Рамка и фон одинаковые, чтобы зона не конкурировала с ActiveButton.
   ===================================================================== */


ChoosePathWidget {
    background: transparent;
    border: none;
}

ChoosePathWidget > TransparentFrame {
    background: transparent;
    border: none;
}

ChoosePathWidget > TransparentFrame[state="ok"] {
    background: #10b981;
}

ChoosePathWidget > TransparentFrame[state="warn"] {
    background: #d9a520;
}

/* =====================================================================
   ЗАГОЛОВКИ СТРАНИЦ
   ===================================================================== */

ServerLabel {
    padding-left: 1px;
}


/* =====================================================================
   КАЛЕНДАРЬ
   ===================================================================== */

CalendarBigDate {
    color: #b4bcc6;
    font-size: 25pt;
}


/* =====================================================================
   ТАБЛИЦЫ
   ===================================================================== */

UTableWidget {
    background: #141c25;
    border: 1px solid #223040;
    border-radius: 8px;
    color: #c9d1da;
    gridline-color: #232f3b;
    padding: 2px 2px 2px 2px;
    selection-background-color: #22303f;
    selection-color: #c9d1da;
}

UTableWidget QTableCornerButton::section {
    background: #1d2834;
    border: none;
    border-bottom: 1px solid #223040;
    border-right: 1px solid #223040;
}

UTableWidget QHeaderView::section {
    background: #1d2834;
    color: #9aa6b2;
    border: none;
    border-bottom: 1px solid #223040;
    padding: 5px 8px 5px 8px;
    font-size: 11px;
    font-weight: normal;
}

UTableWidget::item {
    background: transparent;
    border: none;
    color: #c9d1da;
    padding: 4px 8px 4px 8px;
}

UTableWidget::item:selected,
UTableWidget::item:selected:!active {
    background: #22303f;
    color: #c9d1da;
}


ServerList {
    background: #1d2834;
    border: 1px solid #2b3947;
    border-radius: 6px;
    color: #c9d1da;
    padding: 4px 4px 4px 4px;
}

ServerList::item {
    background: transparent;
    border: none;
    color: #c9d1da;
    height: 30px;
}

ServerList::item:selected,
ServerList::item:selected:!active {
    background: #2f3f53;
    border-radius: 6px;
}

IgnoreListWin UListWidget {
    background: #1d2834;
    border: 1px solid #2b3947;
    border-radius: 6px;
    color: #c9d1da;
    padding: 4px 4px 4px 4px;
}

IgnoreListWin UListWidget::item {
    background: transparent;
    border: none;
    color: #c9d1da;
    height: 30px;
}

IgnoreListWin UListWidget::item:selected,
IgnoreListWin UListWidget::item:selected:!active {
    background: #2f3f53;
    border-radius: 6px;
}




UTextEdit {
    background: #1d2834;
    border: 1px solid #2b3947;
    border-radius: 6px;
    color: #c9d1da;
    padding: 5px 2px 5px 2px;
}


MfAliasWidget ULineEdit {
    background: #212e3b;
}

MfAliasWidget UPushButton {
    background: #212e3b;
}